---
/*
  TaxelField — the homepage hero background.

  A hexagonal tactile-sensor array ("taxels") drawn on a canvas. The cursor acts
  as a contact: taxels under it light up with a pressure falloff and decay
  afterwards, and a small readout reports the summed "force". When nobody is
  touching it, a slow ambient contact drifts across so the hero never looks dead.

  Honours prefers-reduced-motion (static grid, no animation) and pauses when the
  hero is scrolled out of view.

  Usage: place inside a `position: relative` element; it fills that element and
  listens for pointer movement on it. Optional readout targets:
    [data-taxel-force]  → summed force, e.g. "1.42"
    [data-taxel-active] → number of active taxels, e.g. "037"
    [data-taxel-count]  → total taxels in the array
*/
---

<canvas class="taxel-field" aria-hidden="true"></canvas>

<script>
  const ACCENT = [223, 99, 53]; // #df6335

  function initTaxelField(canvas: HTMLCanvasElement) {
    const host = canvas.parentElement as HTMLElement;
    const ctx = canvas.getContext("2d");
    if (!host || !ctx) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const forceEl = host.querySelector<HTMLElement>("[data-taxel-force]");
    const activeEl = host.querySelector<HTMLElement>("[data-taxel-active]");
    const countEl = host.querySelector<HTMLElement>("[data-taxel-count]");

    let W = 0, H = 0, dpr = 1, R = 18;
    let cx: Float32Array = new Float32Array(0);
    let cy: Float32Array = new Float32Array(0);
    let v: Float32Array = new Float32Array(0);
    let base: HTMLCanvasElement | null = null;
    let hexPath: Path2D = new Path2D();

    const hex = (r: number) => {
      const p = new Path2D();
      for (let k = 0; k < 6; k++) {
        const a = (Math.PI / 3) * k + Math.PI / 6; // pointy-top
        const x = r * Math.cos(a), y = r * Math.sin(a);
        k === 0 ? p.moveTo(x, y) : p.lineTo(x, y);
      }
      p.closePath();
      return p;
    };

    function layout() {
      const rect = host.getBoundingClientRect();
      W = Math.max(1, rect.width);
      H = Math.max(1, rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      R = W < 640 ? 14 : 18;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);

      const w = Math.sqrt(3) * R, h = 1.5 * R;
      const cols = Math.ceil(W / w) + 2, rows = Math.ceil(H / h) + 2;
      const xs: number[] = [], ys: number[] = [];
      for (let j = 0; j < rows; j++)
        for (let i = 0; i < cols; i++) {
          xs.push(i * w + (j % 2 ? w / 2 : 0) - w / 2);
          ys.push(j * h - h / 2);
        }
      cx = Float32Array.from(xs);
      cy = Float32Array.from(ys);
      v = new Float32Array(xs.length);
      hexPath = hex(R - 2);
      if (countEl) countEl.textContent = xs.length.toLocaleString("en-GB");

      // Static grid, drawn once.
      base = document.createElement("canvas");
      base.width = canvas.width;
      base.height = canvas.height;
      const b = base.getContext("2d")!;
      b.scale(dpr, dpr);
      b.lineWidth = 1;
      b.strokeStyle = "rgba(255,255,255,0.075)";
      b.fillStyle = "rgba(255,255,255,0.16)";
      for (let n = 0; n < cx.length; n++) {
        b.save();
        b.translate(cx[n], cy[n]);
        b.stroke(hexPath);
        b.fillRect(-0.75, -0.75, 1.5, 1.5);
        b.restore();
      }
      draw();
    }

    // Contact state
    let px = 0, py = 0, touching = false, lastTouch = -1e9;
    const sigma = () => R * 2.4;

    function press(x: number, y: number, strength: number) {
      const s = sigma(), s2 = 2 * s * s, reach = s * 3;
      for (let n = 0; n < cx.length; n++) {
        const dx = cx[n] - x;
        if (dx > reach || dx < -reach) continue;
        const dy = cy[n] - y;
        if (dy > reach || dy < -reach) continue;
        const t = Math.exp(-(dx * dx + dy * dy) / s2) * strength;
        if (t > v[n]) v[n] += (t - v[n]) * 0.4;
      }
    }

    function draw() {
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      if (base) ctx!.drawImage(base, 0, 0);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      let force = 0, active = 0;
      for (let n = 0; n < v.length; n++) {
        const a = v[n];
        if (a < 0.015) continue;
        force += a;
        if (a > 0.08) active++;
        ctx!.save();
        ctx!.translate(cx[n], cy[n]);
        ctx!.fillStyle = `rgba(${ACCENT[0]},${ACCENT[1]},${ACCENT[2]},${(a * 0.42).toFixed(3)})`;
        ctx!.fill(hexPath);
        ctx!.strokeStyle = `rgba(240,150,110,${Math.min(1, a * 0.9).toFixed(3)})`;
        ctx!.stroke(hexPath);
        ctx!.fillStyle = `rgba(255,236,226,${Math.min(1, a).toFixed(3)})`;
        ctx!.fillRect(-1, -1, 2, 2);
        ctx!.restore();
      }
      return { force, active };
    }

    let raf = 0, running = false, t0 = performance.now(), lastReadout = 0;
    function frame(now: number) {
      const t = (now - t0) / 1000;
      if (touching) {
        press(px, py, 1);
      } else if (now - lastTouch > 2500) {
        // Ambient contact: a slow Lissajous drift over the right-hand side.
        const ax = W * (0.68 + 0.2 * Math.sin(t * 0.23));
        const ay = H * (0.5 + 0.3 * Math.sin(t * 0.37 + 1.3));
        press(ax, ay, 0.55);
      }
      for (let n = 0; n < v.length; n++) if (v[n] > 0) v[n] = v[n] < 0.01 ? 0 : v[n] * 0.935;
      const { force, active } = draw();
      if (now - lastReadout > 120) {
        lastReadout = now;
        if (forceEl) forceEl.textContent = (force * 0.06).toFixed(2);
        if (activeEl) activeEl.textContent = String(active).padStart(3, "0");
      }
      raf = requestAnimationFrame(frame);
    }
    const start = () => { if (!running && !reduce) { running = true; raf = requestAnimationFrame(frame); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    host.addEventListener("pointermove", (e) => {
      const r = host.getBoundingClientRect();
      px = e.clientX - r.left;
      py = e.clientY - r.top;
      touching = true;
      lastTouch = performance.now();
    });
    host.addEventListener("pointerleave", () => { touching = false; lastTouch = performance.now(); });
    host.addEventListener("pointerup", (e) => { if (e.pointerType !== "mouse") touching = false; });

    new ResizeObserver(() => layout()).observe(host);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(host);
    layout();
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.taxel-field").forEach(initTaxelField);
</script>

<style>
  .taxel-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Fade the array towards the edges so it reads as texture, not pattern. */
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 65% 50%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 75% 85% at 65% 50%, #000 35%, transparent 100%);
  }
</style>
