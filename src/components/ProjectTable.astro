---
/*
  ProjectTable — a compact table of MSc / MEng student projects (People page).

  Data: people entries whose `programme` is MSc or MEng (they're listed only
  here, not on the select screen or roster). Fields: name, programme, project,
  supervisors, year. Until any exist, two placeholder rows show the format.

  Example src/content/people/j-smith.md:
    ---
    name: "Jane Smith"
    status: alumni
    group: Students
    role: "MSc Student"
    programme: "MSc"
    project: "Tactile skins for soft grippers"
    supervisors: "Prof. Kaspar Althoefer"
    year: 2025
    ---
*/
import { withBase } from "../lib/urls";
import type { Person } from "../lib/content";

interface Props {
  people: Person[];
}
const { people } = Astro.props;

const FIELDS = [
  { key: "name", label: "Name", ph: "Full name" },
  { key: "programme", label: "Programme", ph: "MSc / MEng" },
  { key: "project", label: "Project Title", ph: "Research project title" },
  { key: "supervisors", label: "Supervisors", ph: "Supervisor name(s)" },
  { key: "year", label: "Year", ph: "Graduation year" },
] as const;

type Row = { href?: string; placeholder: boolean; cells: Record<string, string> };
const rows: Row[] =
  people.length > 0
    ? [...people]
        .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.name.localeCompare(b.data.name))
        .map((p) => ({
          href: withBase(`/people/${p.id}`),
          placeholder: false,
          cells: {
            name: p.data.name,
            programme: p.data.programme ?? "",
            project: p.data.project ?? "",
            supervisors: p.data.supervisors ?? "",
            year: p.data.year ? String(p.data.year) : "",
          },
        }))
    : [0, 1].map(() => ({ placeholder: true, cells: Object.fromEntries(FIELDS.map((f) => [f.key, f.ph])) }));
---

<div class="alumni">
  <div class="al-head" aria-hidden="true">
    {FIELDS.map((f) => <span class="label-mono">{f.label}</span>)}
  </div>
  <ul>
    {rows.map((r) => (
      <li class:list={["al-row", r.placeholder && "is-ph"]}>
        {FIELDS.map((f) => (
          <div class={`al-cell al-${f.key}`}>
            <span class="al-label label-mono">{f.label}</span>
            {f.key === "name" && r.href ? (
              <a href={r.href} class="al-val font-serif" data-sfx="tick">{r.cells.name}</a>
            ) : (
              <span class:list={["al-val", f.key === "name" && "font-serif"]}>{r.cells[f.key] || "—"}</span>
            )}
          </div>
        ))}
      </li>
    ))}
  </ul>
  {rows[0]?.placeholder && (
    <p class="label-mono mt-4 text-slate-400">Placeholder rows — projects will appear here once added.</p>
  )}
</div>

<style>
  .alumni {
    font-size: 0.8125rem;
  }
  .al-head,
  .al-row {
    display: grid;
    grid-template-columns: 1.3fr 1.1fr 2.4fr 1.6fr 1fr;
    gap: 1rem;
  }
  .al-head {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #0b0b0b;
    color: #8a8a86;
  }
  .al-row {
    padding: 0.85rem 0;
    border-bottom: 1px solid #e2e8f0;
    color: #334155;
    transition: background-color 0.2s;
  }
  .al-row:not(.is-ph):hover {
    background: #fdf3ee;
  }
  .al-name .al-val {
    font-size: 1rem;
    color: #0b0b0b;
  }
  a.al-val:hover {
    color: #a33e1d;
  }
  .al-year .al-val {
    font-family: var(--font-mono);
  }
  .al-label {
    display: none;
  }
  .is-ph .al-val {
    color: #b4b4b0;
    font-style: italic;
  }
  .is-ph {
    border-bottom-style: dashed;
  }

  /* Phones / small tablets: each row becomes a small labelled card. */
  @media (max-width: 767px) {
    .al-head {
      display: none;
    }
    .al-row {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 1rem;
      padding: 1rem 0;
    }
    .al-name,
    .al-project {
      grid-column: 1 / -1;
    }
    .al-label {
      display: block;
      margin-bottom: 0.15rem;
      font-size: 0.58rem;
      color: #8a8a86;
    }
  }
</style>
