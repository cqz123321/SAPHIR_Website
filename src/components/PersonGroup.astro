---
import PersonCard from "./PersonCard.astro";
import type { Person } from "../lib/content";

interface Props {
  title: string;
  people: Person[];
  index?: number;
}
const { title, people, index } = Astro.props;
---

<section class="mb-16">
  <div class="mb-8 flex items-baseline gap-4 border-b border-slate-900 pb-3">
    {index && <span class="label-mono text-accent-600">G.{String(index).padStart(2, "0")}</span>}
    <h2 class="font-serif text-2xl tracking-tight text-slate-900">{title}</h2>
    <span class="label-mono ml-auto text-slate-400">{String(people.length).padStart(2, "0")}</span>
  </div>
  <div class="grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-2">
    {people.map((p) => <PersonCard person={p} />)}
  </div>
</section>
