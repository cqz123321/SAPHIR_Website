---
/*
  HeaderMotif — the animated background of an inner-page header. One canvas,
  a different drawing per page, all in the same quiet line-art language:

    network  People        — one node per member, joined into a soft mesh that
                             gives way under the cursor (a mass–spring body)
    terrain  Research      — a continuous stiffness map: coloured bands from soft
                             to stiff with contour lines; the cursor is a probe
                             that finds a stiff inclusion
    stream   Publications  — drifting columns of years / venues / DOI prefixes
    reticle  Figures       — measurement grid + crosshair with live coordinates
    film     Lab Life      — a film strip of the group's own photos sliding through a gate
    radar    Contact       — range rings, a sweep, and a ping at Mile End
    ribbon   Profiles      — a band of contour lines (like the logo's), shaped
                             by the person's slug so every profile is unique
    timeline News          — a time axis drifting past, with events lighting up
                             as they cross the "now" line
    noise    404           — faint static and a rolling tear

  Pauses off-screen; draws a single still frame for prefers-reduced-motion.
  Fills its positioned parent and listens for the pointer on that parent.
*/
import type { MotifKind } from "../lib/motifs";
interface Props {
  kind: MotifKind;
  /** ribbon: any string (e.g. a person's slug) — shapes the pattern. */
  seed?: string;
  /** network: number of nodes (e.g. team size). */
  count?: number;
  /** terrain: draw the soft→stiff colour key (top right). */
  legend?: boolean;
  /** film: photo URLs shown in the frames, in order. */
  images?: string[];
}
const { kind, seed = "", count = 13, legend = true, images = [] } = Astro.props;
---

<canvas
  class="header-motif"
  data-kind={kind}
  data-seed={seed}
  data-count={count}
  data-legend={legend ? "1" : "0"}
  data-images={images.length ? JSON.stringify(images) : undefined}
  aria-hidden="true"></canvas>

<script>
  type Ctx = CanvasRenderingContext2D;
  type State = { w: number; h: number; t: number; mx: number; my: number; hover: boolean; seed: number; n: number; legend: boolean; mem: any; imgs: HTMLImageElement[] };

  const O = (a: number) => `rgba(223,99,53,${a})`; // accent
  const Wt = (a: number) => `rgba(255,255,255,${a})`;
  const MONO = 'ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace';

  // ---------- motifs ----------
  // Seeded PRNG (mulberry32) so layouts are stable per page / person.
  const rng = (seed: number) => () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  const network = (c: Ctx, s: State) => {
    type N = { hx: number; hy: number; x: number; y: number; vx: number; vy: number; ph: number; r: number; hot: boolean };
    const key = `${s.w}x${s.h}`;
    if (!s.mem || s.mem.key !== key) {
      const R = rng(7 + s.n);
      const nodes: N[] = [];
      for (let i = 0; i < s.n; i++) {
        // spread over the right two-thirds, on a jittered ellipse-ish cloud
        const a = (i / s.n) * Math.PI * 2 + R() * 0.6;
        const rr = 0.35 + R() * 0.65;
        const hx = s.w * (0.66 + 0.26 * rr * Math.cos(a)), hy = s.h * (0.5 + 0.36 * rr * Math.sin(a));
        nodes.push({ hx, hy, x: hx, y: hy, vx: 0, vy: 0, ph: R() * 6.28, r: i === 0 ? 4 : 2.2 + R() * 1.4, hot: i === 0 || R() < 0.18 });
      }
      // each node links to its 3 nearest neighbours → a soft mesh
      const links: [number, number, number][] = [];
      const seen = new Set<string>();
      nodes.forEach((p, i) => {
        nodes
          .map((q, j) => ({ j, d: Math.hypot(p.hx - q.hx, p.hy - q.hy) }))
          .filter((o) => o.j !== i)
          .sort((u, v) => u.d - v.d)
          .slice(0, 3)
          .forEach(({ j, d }) => {
            const k = i < j ? `${i}-${j}` : `${j}-${i}`;
            if (!seen.has(k)) { seen.add(k); links.push([i, j, d]); }
          });
      });
      s.mem = { key, nodes, links };
    }
    const { nodes, links } = s.mem as { nodes: N[]; links: [number, number, number][] };
    // physics: spring to a slowly breathing home, springs along links, cursor pushes
    for (const p of nodes) {
      const tx = p.hx + Math.sin(s.t * 0.35 + p.ph) * 14, ty = p.hy + Math.cos(s.t * 0.28 + p.ph) * 10;
      p.vx += (tx - p.x) * 0.012; p.vy += (ty - p.y) * 0.012;
      if (s.hover) {
        const dx = p.x - s.mx, dy = p.y - s.my, d2 = dx * dx + dy * dy, R2 = 140 * 140;
        if (d2 < R2) { const f = (1 - d2 / R2) * 2.2 / Math.sqrt(d2 + 1); p.vx += dx * f; p.vy += dy * f; }
      }
    }
    for (const [i, j, L] of links) {
      const a = nodes[i], b = nodes[j];
      const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1;
      const f = ((d - L) / d) * 0.02;
      a.vx += dx * f; a.vy += dy * f; b.vx -= dx * f; b.vy -= dy * f;
    }
    for (const p of nodes) { p.vx *= 0.86; p.vy *= 0.86; p.x += p.vx; p.y += p.vy; }
    // draw
    for (const [i, j, L] of links) {
      const a = nodes[i], b = nodes[j];
      const stretch = Math.min(1, Math.abs(Math.hypot(b.x - a.x, b.y - a.y) - L) / 30);
      c.strokeStyle = stretch > 0.05 ? O(0.15 + stretch * 0.6) : Wt(0.13);
      c.lineWidth = 1;
      c.beginPath(); c.moveTo(a.x, a.y); c.lineTo(b.x, b.y); c.stroke();
    }
    for (const p of nodes) {
      c.fillStyle = p.hot ? O(0.95) : Wt(0.7);
      c.beginPath(); c.arc(p.x, p.y, p.r, 0, Math.PI * 2); c.fill();
      c.strokeStyle = p.hot ? O(0.25) : Wt(0.08);
      c.beginPath(); c.arc(p.x, p.y, p.r + 6 + Math.sin(s.t * 1.2 + p.ph) * 2, 0, Math.PI * 2); c.stroke();
    }
  };

  // soft → stiff colour key: transparent → deep brown → signal orange → pale
  const STOPS: [number, number, number, number, number][] = [
    [0.0, 11, 11, 11, 0],
    [0.3, 40, 22, 16, 0.55],
    [0.55, 110, 46, 22, 0.8],
    [0.78, 223, 99, 53, 0.92],
    [1.0, 246, 196, 170, 0.9],
  ];
  const cmap = (v: number) => {
    v = Math.max(0, Math.min(1, v));
    for (let k = 1; k < STOPS.length; k++)
      if (v <= STOPS[k][0]) {
        const [a0, r0, g0, b0, al0] = STOPS[k - 1], [a1, r1, g1, b1, al1] = STOPS[k];
        const u = (v - a0) / (a1 - a0);
        return [r0 + (r1 - r0) * u, g0 + (g1 - g0) * u, b0 + (b1 - b0) * u, al0 + (al1 - al0) * u];
      }
    return STOPS[STOPS.length - 1].slice(1);
  };

  const terrain = (c: Ctx, s: State) => {
    const cs = s.w < 640 ? 7 : 6, LV = 14;
    const gw = Math.ceil(s.w / cs) + 1, gh = Math.ceil(s.h / cs) + 1;
    if (!s.mem || s.mem.gw !== gw || s.mem.gh !== gh) {
      const off = document.createElement("canvas");
      off.width = gw; off.height = gh;
      s.mem = { gw, gh, f: new Float32Array(gw * gh), off, octx: off.getContext("2d")!, img: new ImageData(gw, gh), probe: 0 };
    }
    const m = s.mem;
    const H = s.h, t = s.t;
    // hills (x, y as fractions of width/height; r as fraction of height)
    const hills = [
      [0.72, 0.45, 0.92, 0.19], [0.88, 0.22, 0.7, 0.13], [0.9, 0.78, 0.85, 0.2],
      [0.55, 0.85, 0.45, 0.12], [0.8, 0.72, -0.4, 0.09], [0.45, 0.2, 0.3, 0.13],
    ].map(([x, y, a, r], i) => [
      (x + 0.025 * Math.sin(t * 0.18 + i)) * s.w,
      (y + 0.03 * Math.cos(t * 0.15 + i * 1.3)) * H, a, (r * H) ** 2 * 2,
    ]);
    m.probe += ((s.hover ? 1 : 0) - m.probe) * 0.06;
    const pr2 = (0.075 * H) ** 2 * 2;
    for (let j = 0; j < gh; j++) {
      const y = j * cs;
      for (let i = 0; i < gw; i++) {
        const x = i * cs;
        let v = 0.08 + 0.07 * Math.sin(x / H * 7 + t * 0.25) * Math.sin(y / H * 6 - t * 0.2) + 0.035 * Math.sin((x + y) / H * 19);
        for (const [hx, hy, a, r2] of hills) { const dx = x - hx, dy = y - hy; v += a * Math.exp(-(dx * dx + dy * dy) / r2); }
        if (m.probe > 0.01) { const dx = x - s.mx, dy = y - s.my; v += 0.75 * m.probe * Math.exp(-(dx * dx + dy * dy) / pr2); }
        m.f[j * gw + i] = v;
      }
    }
    // filled colour bands (quantised → terrain-map steps), upscaled smoothly
    const d = m.img.data;
    for (let k = 0; k < gw * gh; k++) {
      const q = Math.floor(Math.max(0, Math.min(0.999, m.f[k])) * LV) / LV;
      const [r, g, b, a] = cmap(q);
      d[k * 4] = r; d[k * 4 + 1] = g; d[k * 4 + 2] = b; d[k * 4 + 3] = a * 255;
    }
    m.octx.putImageData(m.img, 0, 0);
    c.imageSmoothingEnabled = true;
    c.drawImage(m.off, 0, 0, gw * cs, gh * cs);
    // contour lines (marching squares), every 4th one stronger like a topo map
    for (let L = 1; L < LV; L++) {
      const iso = L / LV;
      c.strokeStyle = L % 4 === 0 ? Wt(0.32) : Wt(0.1);
      c.lineWidth = L % 4 === 0 ? 1.1 : 0.8;
      c.beginPath();
      for (let j = 0; j < gh - 1; j++)
        for (let i = 0; i < gw - 1; i++) {
          const a = m.f[j * gw + i], b = m.f[j * gw + i + 1], cc = m.f[(j + 1) * gw + i + 1], dd = m.f[(j + 1) * gw + i];
          const idx = (a > iso ? 8 : 0) | (b > iso ? 4 : 0) | (cc > iso ? 2 : 0) | (dd > iso ? 1 : 0);
          if (idx === 0 || idx === 15) continue;
          const x = i * cs, y = j * cs;
          const T = [x + cs * ((iso - a) / (b - a)), y];
          const R = [x + cs, y + cs * ((iso - b) / (cc - b))];
          const B = [x + cs * ((iso - dd) / (cc - dd)), y + cs];
          const Lf = [x, y + cs * ((iso - a) / (dd - a))];
          const seg = (p: number[], q: number[]) => { c.moveTo(p[0], p[1]); c.lineTo(q[0], q[1]); };
          switch (idx) {
            case 1: case 14: seg(Lf, B); break;
            case 2: case 13: seg(B, R); break;
            case 3: case 12: seg(Lf, R); break;
            case 4: case 11: seg(T, R); break;
            case 5: seg(Lf, T); seg(B, R); break;
            case 6: case 9: seg(T, B); break;
            case 7: case 8: seg(Lf, T); break;
            case 10: seg(T, R); seg(Lf, B); break;
          }
        }
      c.stroke();
    }
    // probe marker
    if (m.probe > 0.05) {
      c.strokeStyle = Wt(0.8 * m.probe);
      c.lineWidth = 1;
      c.beginPath(); c.arc(s.mx, s.my, 10, 0, Math.PI * 2); c.moveTo(s.mx - 16, s.my); c.lineTo(s.mx - 6, s.my); c.moveTo(s.mx + 6, s.my); c.lineTo(s.mx + 16, s.my); c.stroke();
    }
    // colour key
    if (s.legend && s.w >= 640) {
      const lx = s.w - 196, ly = 64, lw = 150;
      for (let k = 0; k < lw; k++) {
        const [r, g, b, a] = cmap(Math.floor((k / lw) * LV) / LV);
        c.fillStyle = `rgba(${r | 0},${g | 0},${b | 0},${Math.max(a, 0.12)})`;
        c.fillRect(lx + k, ly, 1, 6);
      }
      c.strokeStyle = Wt(0.25); c.strokeRect(lx - 0.5, ly - 0.5, lw + 1, 7);
      c.fillStyle = Wt(0.5);
      c.font = `9px ${MONO}`;
      c.fillText("SOFT", lx, ly + 20);
      c.textAlign = "right"; c.fillText("STIFF", lx + lw, ly + 20); c.textAlign = "left";
    }
  };

  const streamCols: { x: number; v: number; s: string[]; hot: number }[] = [];
  const TOKENS = ["2026", "2025", "2024", "2023", "2022", "10.1109", "10.1038", "IEEE", "RA-L", "ICRA", "IROS", "T-RO", "SOFT", "TACT", "DOI", "N 13", "0.42"];
  const stream = (c: Ctx, s: State) => {
    const colW = s.w < 640 ? 56 : 76, pitch = 22;
    const n = Math.ceil(s.w / colW);
    if (streamCols.length !== n) {
      streamCols.length = 0;
      for (let i = 0; i < n; i++)
        streamCols.push({
          x: i * colW + 8,
          v: 6 + Math.random() * 16,
          s: Array.from({ length: 40 }, () => TOKENS[(Math.random() * TOKENS.length) | 0]),
          hot: (Math.random() * 40) | 0,
        });
    }
    c.font = `10px ${MONO}`;
    const rows = Math.ceil(s.h / pitch) + 2;
    for (const col of streamCols) {
      const shift = s.t * col.v;
      const first = Math.floor(shift / pitch);
      for (let k = -1; k < rows; k++) {
        const y = k * pitch + (shift % pitch);
        const idx = (((k - first) % col.s.length) + col.s.length) % col.s.length;
        c.fillStyle = idx === col.hot ? O(0.9) : Wt(idx % 4 === 0 ? 0.16 : 0.07);
        c.fillText(col.s[idx], col.x, y);
      }
    }
  };

  const reticle = (c: Ctx, s: State) => {
    const step = 24;
    c.lineWidth = 1;
    for (let x = 0; x < s.w; x += step) {
      c.strokeStyle = Wt(x % (step * 5) === 0 ? 0.08 : 0.035);
      c.beginPath(); c.moveTo(x + 0.5, 0); c.lineTo(x + 0.5, s.h); c.stroke();
    }
    for (let y = 0; y < s.h; y += step) {
      c.strokeStyle = Wt(y % (step * 5) === 0 ? 0.08 : 0.035);
      c.beginPath(); c.moveTo(0, y + 0.5); c.lineTo(s.w, y + 0.5); c.stroke();
    }
    const x = s.hover ? s.mx : s.w * (0.7 + 0.15 * Math.sin(s.t * 0.35));
    const y = s.hover ? s.my : s.h * (0.5 + 0.25 * Math.sin(s.t * 0.52));
    c.strokeStyle = O(0.75);
    c.beginPath(); c.moveTo(x, 0); c.lineTo(x, s.h); c.moveTo(0, y); c.lineTo(s.w, y); c.stroke();
    const b = 26, k = 8;
    c.lineWidth = 1.5;
    c.beginPath();
    for (const [sx, sy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
      c.moveTo(x + sx * b, y + sy * (b - k)); c.lineTo(x + sx * b, y + sy * b); c.lineTo(x + sx * (b - k), y + sy * b);
    }
    c.stroke();
    c.fillStyle = O(1);
    c.font = `10px ${MONO}`;
    c.fillText(`X ${String(Math.round(x)).padStart(4, "0")}  Y ${String(Math.round(y)).padStart(4, "0")}`, x + b + 8, y - b - 4);
  };

  const film = (c: Ctx, s: State) => {
    const fh = Math.min(170, s.h * 0.5), fw = fh * 1.35, gap = 14, pitch = fw + gap;
    const y0 = s.h * 0.5 - fh / 2;
    const run = s.t * 28;
    const off = run % pitch;
    const gx = s.w * 0.68 - fw / 2; // the gate
    const imgs = s.imgs.filter((im) => im.complete && im.naturalWidth > 0);
    const n = s.imgs.length;
    let inGate = -1;
    c.fillStyle = Wt(0.03);
    c.fillRect(0, y0 - 26, s.w, fh + 52);
    for (let j = 0, x = -fw + off - pitch; x < s.w + fw; j++, x += pitch) {
      // each frame keeps its photo as the strip moves (new frames enter from the left)
      const slot = j - Math.floor(run / pitch);
      const k = n ? ((slot % n) + n) % n : 0;
      const im = n ? s.imgs[k] : null;
      const near = Math.max(0, 1 - Math.abs(x - gx) / fw); // 1 = sitting in the gate
      if (near > 0.5) inGate = k;
      if (im && imgs.includes(im)) {
        // cover-crop the photo into the frame
        const r = Math.max(fw / im.naturalWidth, fh / im.naturalHeight);
        const sw = fw / r, sh = fh / r;
        c.save();
        c.beginPath(); c.rect(x, y0, fw, fh); c.clip();
        c.globalAlpha = 0.28 + 0.62 * near;
        c.filter = near > 0.35 ? "none" : "grayscale(1) contrast(0.9)";
        c.drawImage(im, (im.naturalWidth - sw) / 2, (im.naturalHeight - sh) / 2, sw, sh, x, y0, fw, fh);
        c.restore();
        c.filter = "none";
        c.strokeStyle = Wt(0.14);
        c.strokeRect(x + 0.5, y0 + 0.5, fw, fh);
      } else {
        c.strokeStyle = Wt(0.14);
        c.strokeRect(x + 0.5, y0 + 0.5, fw, fh);
        // a quiet "image": horizon + sun
        c.strokeStyle = Wt(0.07);
        c.beginPath(); c.moveTo(x + 8, y0 + fh * 0.7); c.lineTo(x + fw * 0.4, y0 + fh * 0.45); c.lineTo(x + fw * 0.65, y0 + fh * 0.62); c.lineTo(x + fw - 8, y0 + fh * 0.38); c.stroke();
        c.beginPath(); c.arc(x + fw * 0.75, y0 + fh * 0.25, 9, 0, Math.PI * 2); c.stroke();
      }
    }
    for (let x = -(s.t * 28) % 22; x < s.w; x += 22) {
      c.fillStyle = Wt(0.12);
      c.fillRect(x, y0 - 18, 10, 7);
      c.fillRect(x, y0 + fh + 11, 10, 7);
    }
    // the frame in the gate
    c.strokeStyle = O(0.85);
    c.lineWidth = 1.5;
    c.strokeRect(gx, y0 - 6, fw, fh + 12);
    c.lineWidth = 1;
    c.fillStyle = O(1);
    c.font = `10px ${MONO}`;
    c.fillText(
      n ? `FRAME ${inGate < 0 ? "--" : String(inGate + 1).padStart(2, "0")} / ${String(n).padStart(2, "0")}` : `FRAME ${String(Math.floor(s.t * 2) % 999).padStart(3, "0")}`,
      gx,
      y0 + fh + 36,
    );
  };

  const radar = (c: Ctx, s: State) => {
    const cx = s.w * (s.w < 640 ? 0.75 : 0.72), cy = s.h * 0.52, R = Math.max(s.w, s.h) * 0.5;
    c.lineWidth = 1;
    for (let r = 40; r < R; r += 44) {
      c.strokeStyle = Wt(0.07);
      c.beginPath(); c.arc(cx, cy, r, 0, Math.PI * 2); c.stroke();
    }
    c.strokeStyle = Wt(0.06);
    c.beginPath(); c.moveTo(cx - R, cy); c.lineTo(cx + R, cy); c.moveTo(cx, cy - R); c.lineTo(cx, cy + R); c.stroke();
    const a = (s.t * 0.9) % (Math.PI * 2);
    for (let k = 0; k < 24; k++) {
      const aa = a - k * 0.025;
      c.strokeStyle = O(0.5 * (1 - k / 24));
      c.beginPath(); c.moveTo(cx, cy); c.lineTo(cx + Math.cos(aa) * R, cy + Math.sin(aa) * R); c.stroke();
    }
    const ph = (s.t % 2.4) / 2.4;
    c.strokeStyle = O(0.8 * (1 - ph));
    c.beginPath(); c.arc(cx, cy, 6 + ph * 60, 0, Math.PI * 2); c.stroke();
    c.fillStyle = O(1);
    c.beginPath(); c.arc(cx, cy, 3.5, 0, Math.PI * 2); c.fill();
    if (s.w >= 640) {
      c.font = `10px ${MONO}`;
      c.fillText("SAPHIR · MILE END", cx + 12, cy - 10);
      c.fillStyle = Wt(0.4);
      c.fillText("51.5241 N  0.0404 W", cx + 12, cy + 18);
    }
  };

  const ribbon = (c: Ctx, s: State) => {
    if (!s.mem) {
      const R = rng(s.seed);
      s.mem = {
        k1: 0.004 + R() * 0.004, k2: 0.009 + R() * 0.008, k3: 0.006 + R() * 0.006,
        p1: R() * 6.28, p2: R() * 6.28, p3: R() * 6.28,
        a1: 0.18 + R() * 0.12, a2: 0.05 + R() * 0.07, gap: 4 + R() * 3, lines: 13 + Math.floor(R() * 6),
        tilt: (R() - 0.5) * 0.35,
      };
    }
    const m = s.mem, mid = s.h * 0.5, M = m.lines, x0 = s.w * 0.18;
    for (let i = 0; i < M; i++) {
      const u = i / (M - 1) - 0.5; // −0.5 … 0.5 across the band
      const core = 1 - Math.abs(u) * 2; // 1 at the centre
      c.strokeStyle = core > 0.55 ? O(0.25 + core * 0.6) : Wt(0.06 + core * 0.22);
      c.lineWidth = core > 0.8 ? 1.4 : 1;
      c.beginPath();
      for (let x = x0; x <= s.w + 4; x += 4) {
        const fade = Math.min(1, (x - x0) / (s.w * 0.25));
        const spine = mid + (x - s.w * 0.6) * m.tilt
          + s.h * m.a1 * Math.sin(x * m.k1 + m.p1 + s.t * 0.22)
          + s.h * m.a2 * Math.sin(x * m.k2 + m.p2 - s.t * 0.31);
        const width = m.gap * (1.1 + 0.8 * Math.sin(x * m.k3 + m.p3 + s.t * 0.18)); // pinches and swells
        const y = spine + u * M * width * fade;
        x === x0 ? c.moveTo(x, y) : c.lineTo(x, y);
      }
      c.stroke();
    }
  };

  const timeline = (c: Ctx, s: State) => {
    const y = s.h * 0.56, speed = 22, gap = 18, x0 = s.w * 0.22;
    const now = s.w * 0.72;
    const shift = (s.t * speed) % gap;
    // axis + ticks (a long tick every 6 small ones, labelled like months)
    c.strokeStyle = Wt(0.18); c.lineWidth = 1;
    c.beginPath(); c.moveTo(x0, y + 0.5); c.lineTo(s.w, y + 0.5); c.stroke();
    const first = Math.floor((s.t * speed) / gap);
    c.font = `9px ${MONO}`;
    for (let k = 0, x = x0 - shift + gap; x < s.w + gap; k++, x += gap) {
      const idx = first + k + 1;
      const major = idx % 6 === 0;
      c.strokeStyle = Wt(major ? 0.3 : 0.12);
      c.beginPath(); c.moveTo(x, y - (major ? 9 : 4)); c.lineTo(x, y + (major ? 9 : 4)); c.stroke();
      if (major) { c.fillStyle = Wt(0.28); c.fillText(String(((idx / 6) % 12) + 1).padStart(2, "0"), x - 6, y + 24); }
      // events: a deterministic sprinkling of markers along the axis
      const h = Math.sin(idx * 12.9898) * 43758.5453; const r = h - Math.floor(h);
      if (r > 0.82) {
        const lit = Math.max(0, 1 - Math.abs(x - now) / 120);
        const stem = 18 + (r - 0.82) * 260;
        c.strokeStyle = lit > 0.02 ? O(0.3 + lit * 0.7) : Wt(0.16);
        c.beginPath(); c.moveTo(x, y); c.lineTo(x, y - stem); c.stroke();
        c.fillStyle = lit > 0.02 ? O(0.5 + lit * 0.5) : Wt(0.35);
        c.beginPath(); c.arc(x, y - stem, 2.5 + lit * 2, 0, Math.PI * 2); c.fill();
        if (lit > 0.6) { c.strokeStyle = O(0.5 * lit); c.beginPath(); c.arc(x, y - stem, 9 + (1 - lit) * 20, 0, Math.PI * 2); c.stroke(); }
      }
    }
    // the "now" cursor
    c.strokeStyle = O(0.8);
    c.setLineDash([3, 4]);
    c.beginPath(); c.moveTo(now, 20); c.lineTo(now, s.h - 20); c.stroke();
    c.setLineDash([]);
    c.fillStyle = O(1); c.font = `10px ${MONO}`;
    c.fillText("NOW", now + 8, 34);
  };

  const noise = (c: Ctx, s: State) => {
    const n = Math.floor((s.w * s.h) / 900);
    for (let i = 0; i < n; i++) {
      c.fillStyle = Wt(Math.random() * 0.12);
      c.fillRect(Math.random() * s.w, Math.random() * s.h, 2, 2);
    }
    const y = ((s.t * 70) % (s.h + 80)) - 40;
    c.fillStyle = Wt(0.05);
    c.fillRect(0, y, s.w, 26);
    c.fillStyle = O(0.6);
    c.fillRect(0, y + 12, s.w, 1);
  };

  const DRAW: Record<string, (c: Ctx, s: State) => void> = { network, terrain, stream, reticle, film, radar, ribbon, timeline, noise };

  document.querySelectorAll<HTMLCanvasElement>("canvas.header-motif").forEach((canvas) => {
    const host = canvas.parentElement as HTMLElement;
    const c = canvas.getContext("2d");
    const draw = DRAW[canvas.dataset.kind ?? ""];
    if (!host || !c || !draw) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hash = (str: string) => [...str].reduce((h, ch) => Math.imul(h ^ ch.charCodeAt(0), 16777619), 2166136261) >>> 0;
    const s: State = {
      w: 1, h: 1, t: 3, mx: 0, my: 0, hover: false,
      seed: hash(canvas.dataset.seed || "saphir"),
      n: Number(canvas.dataset.count) || 13,
      legend: canvas.dataset.legend !== "0",
      mem: null,
      imgs: [],
    };
    let dpr = 1;

    const frame = () => {
      c.setTransform(dpr, 0, 0, dpr, 0, 0);
      c.clearRect(0, 0, s.w, s.h);
      draw(c, s);
    };
    const resize = () => {
      const r = host.getBoundingClientRect();
      s.w = Math.max(1, r.width);
      s.h = Math.max(1, r.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(s.w * dpr);
      canvas.height = Math.round(s.h * dpr);
      frame();
    };
    try {
      s.imgs = (JSON.parse(canvas.dataset.images || "[]") as string[]).map((src) => {
        const im = new Image();
        im.decoding = "async";
        im.onload = () => frame(); // also fills the still frame for reduced motion
        im.src = src;
        return im;
      });
    } catch {}
    host.addEventListener("pointermove", (e) => {
      const r = host.getBoundingClientRect();
      s.mx = e.clientX - r.left;
      s.my = e.clientY - r.top;
      s.hover = true;
    });
    host.addEventListener("pointerleave", () => (s.hover = false));
    new ResizeObserver(resize).observe(host);
    resize();
    if (reduce) return;

    let raf = 0, last = performance.now(), on = false;
    const loop = (now: number) => {
      s.t += Math.min(0.05, (now - last) / 1000);
      last = now;
      frame();
      raf = requestAnimationFrame(loop);
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; last = performance.now(); raf = requestAnimationFrame(loop); }
      else if (!e.isIntersecting && on) { on = false; cancelAnimationFrame(raf); }
    }).observe(host);
  });
</script>

<style>
  .header-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 30%, #000 60%);
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 30%, #000 60%);
  }
  @media (max-width: 639px) {
    .header-motif {
      opacity: 0.4;
    }
  }
</style>
