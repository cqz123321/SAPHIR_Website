---
/*
  PageHeader — the dark title band at the top of every inner page.
  Same frame as the homepage hero (meta rows, big title, orange right-angle rule),
  with a page-specific animated motif behind it (see HeaderMotif.astro).

  The title letters rise in one by one; `meta` fills the bottom-left readout and
  the `readout` slot fills the bottom-right.
*/
import HeaderMotif from "./HeaderMotif.astro";
import type { MotifKind } from "../lib/motifs";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  index?: number;
  motif?: MotifKind;
  meta?: string;
  /** network motif: number of nodes */
  count?: number;
}
const { eyebrow, title, lead, index, motif = "terrain", meta, count } = Astro.props;
const idx = index ? String(index).padStart(2, "0") : "";
const chars = [...title];
---

<header class="page-hero relative overflow-hidden bg-[#0b0b0b] text-white">
  <HeaderMotif kind={motif} count={count} />
  <div class="ph-frame container-page relative flex flex-col justify-between">
    <div class="ph-meta flex items-center justify-between gap-4 border-b border-white/15 pb-3 text-neutral-400">
      <span class="label-mono">SAPHIR{idx && <span class="text-neutral-600"> / {idx}</span>}</span>
      {eyebrow && <span class="label-mono text-accent-400">{eyebrow}</span>}
    </div>

    <div class="py-12 sm:py-14">
      <h1 class="ph-title font-display" aria-label={title}>
        <span class="ph-word" aria-hidden="true">
          {chars.map((ch, i) => (
            <span class="ph-ch" style={`--i:${i}`}>{ch === " " ? " " : ch}</span>
          ))}
        </span>
        <span class="ph-rule" aria-hidden="true"></span>
      </h1>
      {lead && <p class="ph-lead mt-7 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg">{lead}</p>}
      <slot name="actions" />
    </div>

    <div class="ph-meta flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-white/15 pt-3 text-neutral-500">
      <span class="label-mono">{meta ?? "Queen Mary University of London"}</span>
      <span class="label-mono"><slot name="readout" /></span>
    </div>
  </div>
</header>

<style>
  .ph-frame {
    min-height: clamp(380px, 52svh, 520px);
    padding-top: 1.75rem;
    padding-bottom: 1.5rem;
    pointer-events: none;
  }
  .ph-frame :global(a),
  .ph-frame :global(button) {
    pointer-events: auto;
  }
  .ph-title {
    display: inline-block;
    font-size: clamp(2.4rem, 9.5vw, 7.5rem);
    color: #fff;
  }
  .ph-word {
    display: block;
    white-space: nowrap;
  }
  .ph-ch {
    display: inline-block;
    opacity: 0;
    animation: ph-rise 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.1s + var(--i) * 0.035s);
  }
  .ph-rule {
    position: relative;
    display: block;
    height: 2px;
    margin-top: 0.14em;
    background: #df6335;
    transform: scaleX(0);
    transform-origin: left;
    animation: ph-line 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.45s forwards;
  }
  .ph-rule::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 0.28em;
    background: #df6335;
    transform: scaleY(0);
    transform-origin: top;
    animation: ph-drop 0.3s ease-out 1.1s forwards;
  }
  .ph-lead,
  .ph-meta {
    opacity: 0;
    animation: ph-fade 0.8s ease 0.7s forwards;
  }
  .ph-meta {
    animation-delay: 0.05s;
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes ph-line {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes ph-drop {
    to {
      transform: scaleY(1);
    }
  }
  @keyframes ph-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-ch,
    .ph-rule,
    .ph-rule::after,
    .ph-lead,
    .ph-meta {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
