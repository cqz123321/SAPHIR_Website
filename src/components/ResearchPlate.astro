---
/*
  ResearchPlate — a small animated line drawing ("technical plate") for one
  research direction on the homepage. Hand-authored inline SVG, no assets.

    kind="soft"     an everting soft robot growing between two obstacles
    kind="tactile"  a hexagonal taxel array with a moving contact + row profile
    kind="arm"      a manipulator reaching down to an object, with a sensor's view

  detail  (Research page) adds a layer of fine detail — taxel IDs and electrode
          combs, film folds and material notes on the everting body, joint-angle
          scales — plus a ×2.5 magnifier that follows the cursor to read it.

  To use a real photo instead, swap <ResearchPlate> for an <Image> in index.astro.
*/
interface Props {
  kind: "soft" | "tactile" | "arm";
  index: number;
  tag: string;
  detail?: boolean;
}
const { kind, index, tag, detail = false } = Astro.props;
const ZOOM = 2.5;
// Research page: the taxel array is touched with the cursor (no magnifier there);
// the other two detail plates get the ×2.5 magnifier.
const touch = detail && kind === "tactile";
const zoom = detail && !touch;
const ticks = (r1: number, r2: number, n = 24) =>
  Array.from({ length: n }, (_, k) => {
    const a = (k / n) * Math.PI * 2;
    const r = k % 6 === 0 ? r2 + 1.2 : r2;
    return `M${(r1 * Math.cos(a)).toFixed(2)} ${(r1 * Math.sin(a)).toFixed(2)}L${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  }).join("");
const id = `plate-${kind}`;
const fig = `FIG.${String(index).padStart(2, "0")}`;

// Taxel grid for the tactile plate (pointy-top hexes).
const R = 13;
const hw = Math.sqrt(3) * R;
const hexD = (() => {
  const r = R - 1.6;
  const pts = Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k + Math.PI / 6;
    return `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  });
  return `M${pts.join("L")}Z`;
})();
const taxels: { x: number; y: number; row: number; col: number }[] = [];
for (let j = 0; j < 8; j++)
  for (let i = 0; i < 9; i++)
    taxels.push({ x: 44 + i * hw + (j % 2 ? hw / 2 : 0), y: 72 + j * 1.5 * R, row: j, col: i });
const C0 = { x: 128, y: 140 };
const p0 = (t: { x: number; y: number }) =>
  Math.exp(-((t.x - C0.x) ** 2 + (t.y - C0.y) ** 2) / (2 * 30 * 30));
const PROFILE_ROW = 3;

// Arm motion. Homepage: reach and return (8 s). Research page (detail): reach,
// lock on, close the gripper, lift the object, put it back, release, return (10 s).
// Poses are solved so the gripper points straight down onto the target at (188, 232).
const ARM = detail
  ? {
      dur: "10s",
      keyTimes: "0;0.3;0.46;0.58;0.68;0.78;0.82;1",
      keySplines: Array(7).fill("0.45 0 0.55 1").join(";"),
      q1: "-8;27;27;16.4;16.4;27;27;-8",
      q2: "10;10.6;10.6;-7.6;-7.6;10.6;10.6;10",
      q3: "40;52.4;52.4;81.2;81.2;52.4;52.4;40",
    }
  : {
      dur: "8s",
      keyTimes: "0;0.5;1",
      keySplines: "0.45 0 0.55 1;0.45 0 0.55 1",
      q1: "-8;14;-8",
      q2: "10;35;10",
      q3: "40;0;40",
    };
const GRIP = { keyTimes: "0;0.37;0.43;0.79;0.83;1", dur: "10s" };
const HELD = { keyTimes: "0;0.44;0.445;0.8;0.805;1", dur: "10s" };
const hexPath = (r: number) =>
  "M" + Array.from({ length: 6 }, (_, k) => {
    const a = (Math.PI / 3) * k;
    return `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  }).join("L") + "Z";
---

<figure class:list={["plate", zoom && "plate-detail", touch && "plate-touch"]} data-plate={kind} data-zoom={zoom ? ZOOM : undefined}>
  <svg viewBox="0 0 400 280" role="img" aria-label={`Illustration: ${tag.toLowerCase()}`}>
    <defs>
      <pattern id={`${id}-dots`} width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.7" fill="#ffffff" fill-opacity="0.09"></circle>
      </pattern>
      <pattern id={`${id}-haz`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" fill="#0f0f0f"></rect>
        <rect width="3" height="6" fill="#df6335"></rect>
      </pattern>
      <pattern id={`${id}-hatch`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="5" stroke="#5c5c5c" stroke-width="1"></line>
      </pattern>
    </defs>

    {zoom && (
      <defs>
        <clipPath id={`${id}-lens`}><circle class="lens-clip" r="46" cx="-100" cy="-100"></circle></clipPath>
      </defs>
    )}
    <g id={`${id}-art`}>
    <rect width="400" height="280" fill={`url(#${id}-dots)`}></rect>

    <!-- frame: corner ticks, labels, scale bar -->
    <g class="frame" fill="none" stroke="#6b6b6b" stroke-width="1">
      <path d="M10 22V10H22M378 10H390V22M390 258V270H378M22 270H10V258"></path>
    </g>
    <text x="22" y="30" class="t">{fig}</text>
    <text x="378" y="30" class="t" text-anchor="end">{tag}</text>
    <g stroke="#8c8c8c" stroke-width="1">
      <path d="M22 256H82M22 252V260M52 254V258M82 252V260"></path>
    </g>
    <text x="90" y="259" class="t">20 MM</text>

    {kind === "soft" && (
      <g>
        <defs>
          <path id={`${id}-path`} d="M80 180 C140 180 150 110 215 110 S300 175 352 120"></path>
          <mask id={`${id}-grow`} maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="280">
            <path d="M80 180 C140 180 150 110 215 110 S300 175 352 120" pathLength="1"
              fill="none" stroke="#fff" stroke-width="34" stroke-dasharray="1 1" stroke-dashoffset="1">
              <animate attributeName="stroke-dashoffset" values="1;0;0" keyTimes="0;0.6;1" dur="7s"
                calcMode="spline" keySplines="0.45 0 0.25 1;0 0 1 1" repeatCount="indefinite"></animate>
            </path>
          </mask>
        </defs>

        <!-- obstacles -->
        <circle cx="150" cy="226" r="30" fill={`url(#${id}-hatch)`} stroke="#5c5c5c"></circle>
        <circle cx="300" cy="80" r="26" fill={`url(#${id}-hatch)`} stroke="#5c5c5c"></circle>

        <!-- base with spool + pressure inlet -->
        <rect x="24" y="148" width="56" height="64" rx="3" fill="#0f0f0f" stroke="#d4d4d4"></rect>
        <circle cx="50" cy="180" r="15" fill="none" stroke="#8c8c8c"></circle>
        <circle cx="50" cy="180" r="3" fill="#8c8c8c"></circle>
        <path d="M4 200H22M16 196L22 200L16 204" fill="none" stroke="#df6335"></path>
        <text x="24" y="232" class="t">BASE · P</text>
        {detail && <rect x="24" y="214" width="56" height="4" fill={`url(#${id}-haz)`}></rect>}
        {detail && (
          <g class="micro" font-size="3" fill="#8c8c8c" letter-spacing="0.3">
            <text x="50" y="199" text-anchor="middle">SPOOLED BODY</text>
            <text x="50" y="164" text-anchor="middle">PRESSURE CHAMBER</text>
            <text x="2" y="194">AIR IN</text>
            <text x="150" y="227" text-anchor="middle">OBSTACLE</text>
            <text x="300" y="81" text-anchor="middle">OBSTACLE</text>
            <path d="M118 202l6 -4M262 104l-6 6" stroke="#df6335" stroke-width="0.4"></path>
            <text x="98" y="207">CLEARANCE</text>
            <text x="258" y="99" text-anchor="end">CLEARANCE</text>
          </g>
        )}

        <!-- body grows in, holds, fades, repeats -->
        <g mask={`url(#${id}-grow)`}>
          <use href={`#${id}-path`} fill="none" stroke="#d4d4d4" stroke-width="22"></use>
          <use href={`#${id}-path`} fill="none" stroke="#0f0f0f" stroke-width="19.5"></use>
          <use href={`#${id}-path`} fill="none" stroke="#df6335" stroke-width="1.2" stroke-dasharray="3 7" class="flow"></use>
          {detail && (
            <g class="micro">
              <use href={`#${id}-path`} fill="none" stroke="#d4d4d4" stroke-opacity="0.22" stroke-width="18" stroke-dasharray="0.5 5.5"></use>
              <text font-size="3" fill="#a3a3a3" letter-spacing="0.3" dy="-6.2">
                <textPath href={`#${id}-path`} startOffset="3%">OUTER WALL · THIN PE FILM · STATIONARY RELATIVE TO THE ENVIRONMENT · OUTER WALL · THIN PE FILM</textPath>
              </text>
              <text font-size="3" fill="#df6335" letter-spacing="0.3" dy="2.8">
                <textPath href={`#${id}-path`} startOffset="6%">INNER MATERIAL FEEDS FORWARD → → → EVERTS AT THE TIP → → →</textPath>
              </text>
            </g>
          )}
        </g>
        <!-- everting tip -->
        <g>
          <circle r="10.5" fill="#0f0f0f" stroke="#d4d4d4" stroke-width="1.2"></circle>
          <circle r="2.6" fill="#df6335"></circle>
          <animateMotion dur="7s" keyPoints="0;1;1" keyTimes="0;0.6;1" calcMode="spline"
            keySplines="0.45 0 0.25 1;0 0 1 1" repeatCount="indefinite">
            <mpath href={`#${id}-path`}></mpath>
          </animateMotion>
        </g>
        {detail && (
          <g transform="translate(352 120)" fill="none" stroke="#df6335">
            <path d={hexPath(14)}>
              <animateTransform attributeName="transform" type="scale" values="1;1;2.4;2.4" keyTimes="0;0.6;0.78;1" dur="7s" repeatCount="indefinite"></animateTransform>
              <animate attributeName="stroke-opacity" values="0;0;0.9;0;0" keyTimes="0;0.599;0.6;0.78;1" dur="7s" repeatCount="indefinite"></animate>
            </path>
            <path d={hexPath(14)} stroke-width="0.6">
              <animateTransform attributeName="transform" type="scale" values="1;1;1;1.7;1.7" keyTimes="0;0.6;0.64;0.82;1" dur="7s" repeatCount="indefinite"></animateTransform>
              <animate attributeName="stroke-opacity" values="0;0;0.7;0;0" keyTimes="0;0.639;0.64;0.82;1" dur="7s" repeatCount="indefinite"></animate>
            </path>
          </g>
        )}
        <path d="M356 106L368 64H382" fill="none" stroke="#6b6b6b"></path>
        <text x="378" y="60" class="t" text-anchor="end">TIP GROWTH</text>
      </g>
    )}

    {kind === "tactile" && (
      <g>
        <rect x="24" y="50" width="222" height="196" rx="10" fill="none" stroke="#5c5c5c"></rect>
        <g class="taxels">
          {taxels.map((t) => {
            const p = touch ? 0 : p0(t);
            return (
              <path
                d={hexD}
                transform={`translate(${t.x.toFixed(2)} ${t.y.toFixed(2)})`}
                data-x={t.x.toFixed(2)}
                data-y={t.y.toFixed(2)}
                data-row={t.row}
                data-col={t.col}
                fill="#df6335"
                fill-opacity={(p * 0.85).toFixed(3)}
                stroke="#d4d4d4"
                stroke-opacity={(0.22 + p * 0.6).toFixed(3)}
              />
            );
          })}
        </g>
        {detail && (
          <g class="micro" pointer-events="none">
            {taxels.map((t, k) => (
              <g transform={`translate(${t.x.toFixed(2)} ${t.y.toFixed(2)})`}>
                <path d="M-3.6 -3.2V1.6M-1.2 -1.6V3.2M1.2 -3.2V1.6M3.6 -1.6V3.2M-3.6 -3.2H1.2M-1.2 3.2H3.6" fill="none" stroke="#d4d4d4" stroke-opacity="0.45" stroke-width="0.35"></path>
                <text y="7.6" font-size="2.4" fill="#a3a3a3" text-anchor="middle" letter-spacing="0.2">T{String(k + 1).padStart(2, "0")}</text>
              </g>
            ))}
            <text x="30" y="243" font-size="3" fill="#8c8c8c" letter-spacing="0.3">72 TAXELS · INTERDIGITATED ELECTRODES · ROW-COLUMN SCAN</text>
          </g>
        )}
        {touch && (
          <g pointer-events="none">
            <polyline class="trail" fill="none" stroke="#df6335" stroke-opacity="0.45" stroke-width="1" stroke-linejoin="round" stroke-dasharray="1.5 2.5"></polyline>
            <g class="shear" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round">
              {taxels.map((t) => <line x1={t.x.toFixed(2)} y1={t.y.toFixed(2)} x2={t.x.toFixed(2)} y2={t.y.toFixed(2)} stroke-opacity="0"></line>)}
            </g>
            <text class="touch-hint" x="135" y="150" text-anchor="middle" font-size="7" fill="#df6335" letter-spacing="1.2">TOUCH THE SKIN</text>
          </g>
        )}
        <g class="contact" transform={`translate(${C0.x} ${C0.y})`} fill="none" stroke="#df6335" opacity={touch ? 0 : undefined} pointer-events="none">
          <circle r="20" stroke-opacity="0.9"></circle>
          <circle r="38" stroke-opacity="0.5" stroke-dasharray="2 4"></circle>
          <circle r="56" stroke-opacity="0.25" stroke-dasharray="2 4"></circle>
          <path d="M-5 0H5M0 -5V5" stroke="#fff"></path>
          {detail && <text x="22" y="-16" font-size="3" fill="#df6335" stroke="none" letter-spacing="0.3">CONTACT · PEAK</text>}
          {touch && <path class="shear-arrow" d="M0 0" stroke="#fff" stroke-width="1.2" stroke-linecap="round"></path>}
          {detail && (
            <g class="ripple" stroke-width="0.8">
              <path d={hexPath(16)}></path>
              <path d={hexPath(16)}></path>
              <path d={hexPath(16)}></path>
            </g>
          )}
        </g>
        <!-- row profile -->
        <path class="row-mark" d={`M24 ${72 + PROFILE_ROW * 1.5 * R}h-8`} stroke="#df6335"></path>
        <g transform="translate(266 70)">
          <path d="M0 0V160H118" fill="none" stroke="#6b6b6b"></path>
          <text x="4" y="8" class="t">F</text>
          <text x="118" y="174" class="t row-label" text-anchor="end">ROW 04</text>
          <g class="bars">
            {taxels.filter((t) => t.row === PROFILE_ROW).map((t, k) => {
              const h = touch ? 0 : p0(t) * 140;
              return <rect x={6 + k * 12.4} y={160 - h} width="7" height={h} fill="#d4d4d4" data-col={t.col} />;
            })}
          </g>
        </g>
      </g>
    )}

    {kind === "arm" && (
      <g>
        <!-- ground -->
        <path d="M24 240H376" stroke="#8c8c8c"></path>
        <path d="M30 240l-6 8M50 240l-6 8M70 240l-6 8M90 240l-6 8M110 240l-6 8M130 240l-6 8M150 240l-6 8M170 240l-6 8M190 240l-6 8M210 240l-6 8M230 240l-6 8M250 240l-6 8M270 240l-6 8M290 240l-6 8M310 240l-6 8M330 240l-6 8M350 240l-6 8M370 240l-6 8" stroke="#4a4a4a"></path>

        <!-- base frame {B} -->
        <g transform="translate(34 226)" stroke="#8c8c8c" fill="none">
          <path d="M0 0H20M16 -3L20 0L16 3"></path>
          <path d="M0 0V-20M-3 -16L0 -20L3 -16"></path>
        </g>
        <text x="38" y="196" class="t">&#123;B&#125;</text>

        <!-- object + planned approach -->
        <ellipse cx="188" cy="232" rx="13" ry="8" fill="#df6335" fill-opacity="0.18" stroke="#df6335">
          {detail && <animate attributeName="rx" values="13;13;9;9;13;13" keyTimes={GRIP.keyTimes} dur={GRIP.dur} repeatCount="indefinite"></animate>}
          {detail && <animate attributeName="opacity" values="1;1;0;0;1;1" keyTimes={HELD.keyTimes} dur={HELD.dur} repeatCount="indefinite"></animate>}
        </ellipse>
        <path d="M184 160C186 185 187 205 187 218" fill="none" stroke="#df6335" stroke-dasharray="3 4"></path>
        <g stroke="#df6335" fill="none">
          <circle cx="188" cy="232" r="20" stroke-opacity="0.45"></circle>
          <path d="M160 232h8M208 232h8"></path>
        </g>
        <text x="218" y="222" class="t">TARGET</text>
        {detail && (
          <g transform="translate(188 232)" fill="none" stroke="#df6335" stroke-width="1.2">
            <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;0.3;0.305;0.44;0.46;1" dur="10s" repeatCount="indefinite"></animate>
            <g>
              <animateTransform attributeName="transform" type="scale" values="2;2;1;1" keyTimes="0;0.3;0.34;1" dur="10s" repeatCount="indefinite"></animateTransform>
              <g>
                <animateTransform attributeName="transform" type="rotate" values="0;0;45;45" keyTimes="0;0.3;0.34;1" dur="10s" repeatCount="indefinite"></animateTransform>
                <path d="M-17 -11V-17H-11M11 -17H17V-11M17 11V17H11M-11 17H-17V11"></path>
              </g>
            </g>
            <text x="22" y="-13" font-size="5" fill="#df6335" stroke="none" letter-spacing="0.6" class="t-lock">LOCK
              <animate attributeName="fill-opacity" values="1;0;1" dur="0.3s" repeatCount="indefinite"></animate>
            </text>
          </g>
        )}
        {detail && (
          <g class="micro" font-size="3" fill="#a3a3a3" letter-spacing="0.3">
            <text x="188" y="233" text-anchor="middle" fill="#df6335">SOFT OBJECT</text>
            <text x="190" y="178">PLANNED APPROACH</text>
            <text x="44" y="236">BASE FRAME</text>
          </g>
        )}

        <!-- sensor + field of view -->
        <rect x="318" y="58" width="26" height="16" rx="2" fill="#0f0f0f" stroke="#d4d4d4"></rect>
        {detail && (
          <g class="micro" stroke="#d4d4d4" stroke-opacity="0.35" stroke-width="0.25">
            <path d="M320 60h22M320 62h22M320 64h22M320 68h22M320 70h22M320 72h22M321 59v14M323 59v14M325 59v14M337 59v14M339 59v14M341 59v14"></path>
            <text x="331" y="80" font-size="2.6" fill="#a3a3a3" stroke="none" text-anchor="middle" letter-spacing="0.2">DEPTH CAMERA</text>
          </g>
        )}
        <circle cx="331" cy="66" r="4" fill="none" stroke="#d4d4d4"></circle>
        <path d="M322 74L176 226M340 74L204 230" stroke="#6b6b6b" stroke-dasharray="1 4"></path>
        <text x="378" y="92" class="t" text-anchor="end">D = <tspan class="range">0.42</tspan> M</text>

        <!-- manipulator: three nested revolute joints -->
        <path d="M70 240L76 222H104L110 240Z" fill="#0f0f0f" stroke="#d4d4d4"></path>
        <g transform="translate(90 222)">
          {detail && (
            <g class="micro">
              <path d={ticks(10, 12)} stroke="#d4d4d4" stroke-opacity="0.5" stroke-width="0.35"></path>
              <text x="-17" y="-13" font-size="3" fill="#df6335" letter-spacing="0.3">q1</text>
            </g>
          )}
          <g>
            <animateTransform attributeName="transform" type="rotate" values={ARM.q1} keyTimes={ARM.keyTimes}
              dur={ARM.dur} calcMode="spline" keySplines={ARM.keySplines} repeatCount="indefinite"></animateTransform>
            <rect x="-6" y="-85" width="12" height="85" rx="6" fill="#0f0f0f" stroke="#d4d4d4"></rect>
            <circle r="8" fill="#0f0f0f" stroke="#d4d4d4"></circle>
            <circle r="2" fill="#d4d4d4"></circle>
            <g transform="translate(0 -85)">
              {detail && (
                <g class="micro">
                  <path d={ticks(9, 11)} stroke="#d4d4d4" stroke-opacity="0.5" stroke-width="0.35"></path>
                  <text x="-16" y="-10" font-size="3" fill="#df6335" letter-spacing="0.3">q2</text>
                </g>
              )}
              <g>
                <animateTransform attributeName="transform" type="rotate" values={ARM.q2} keyTimes={ARM.keyTimes}
                  dur={ARM.dur} calcMode="spline" keySplines={ARM.keySplines} repeatCount="indefinite"></animateTransform>
                <rect x="0" y="-5" width="75" height="10" rx="5" fill="#0f0f0f" stroke="#d4d4d4"></rect>
                <circle r="7" fill="#0f0f0f" stroke="#d4d4d4"></circle>
                <circle r="2" fill="#d4d4d4"></circle>
                <g transform="translate(75 0)">
                  {detail && (
                    <g class="micro">
                      <path d={ticks(8, 10)} stroke="#d4d4d4" stroke-opacity="0.5" stroke-width="0.35"></path>
                      <text x="-14" y="-9" font-size="3" fill="#df6335" letter-spacing="0.3">q3</text>
                    </g>
                  )}
                  <g>
                    <animateTransform attributeName="transform" type="rotate" values={ARM.q3} keyTimes={ARM.keyTimes}
                      dur={ARM.dur} calcMode="spline" keySplines={ARM.keySplines} repeatCount="indefinite"></animateTransform>
                    <rect x="0" y="-4" width="26" height="8" rx="4" fill="#0f0f0f" stroke="#d4d4d4"></rect>
                    <circle r="6" fill="#0f0f0f" stroke="#d4d4d4"></circle>
                    {detail ? (
                      <g>
                        <ellipse cx="40" cy="0" rx="9.5" ry="9" fill="#df6335" fill-opacity="0.3" stroke="#df6335" opacity="0">
                          <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={HELD.keyTimes} dur={HELD.dur} repeatCount="indefinite"></animate>
                        </ellipse>
                        <path d="M26 -14V14" fill="none" stroke="#d4d4d4"></path>
                        <path d="M26 -13H47" fill="none" stroke="#d4d4d4" stroke-width="1.6">
                          <animateTransform attributeName="transform" type="translate" values="0 0;0 0;0 4;0 4;0 0;0 0" keyTimes={GRIP.keyTimes} dur={GRIP.dur} repeatCount="indefinite"></animateTransform>
                        </path>
                        <path d="M26 13H47" fill="none" stroke="#d4d4d4" stroke-width="1.6">
                          <animateTransform attributeName="transform" type="translate" values="0 0;0 0;0 -4;0 -4;0 0;0 0" keyTimes={GRIP.keyTimes} dur={GRIP.dur} repeatCount="indefinite"></animateTransform>
                        </path>
                        <circle cx="40" cy="0" r="1.6" fill="#df6335"></circle>
                        <text x="30" y="-17" font-size="2.6" fill="#a3a3a3" letter-spacing="0.2">TCP</text>
                      </g>
                    ) : (
                      <>
                        <path d="M26 -7V7M26 -7H36M26 7H36" fill="none" stroke="#d4d4d4"></path>
                        <circle cx="31" cy="0" r="1.8" fill="#df6335"></circle>
                      </>
                    )}
                  </g>
                </g>
              </g>
            </g>
          </g>
        </g>
      </g>
    )}
    </g>
    {zoom && (
      <g class="loupe" aria-hidden="true">
        <g clip-path={`url(#${id}-lens)`}>
          <rect width="400" height="280" fill="#0f0f0f"></rect>
          <g class="loupe-view"></g>
        </g>
        <g class="loupe-ring" transform="translate(-100 -100)" fill="none">
          <circle r="46" stroke="#df6335" stroke-width="1.2"></circle>
          <circle r="49" stroke="#df6335" stroke-opacity="0.3" stroke-width="0.6" stroke-dasharray="1 3"></circle>
          <path d="M-46 0h-7M46 0h7M0 -46v-7M0 46v7" stroke="#df6335"></path>
          <text x="34" y="44" font-size="7" fill="#df6335" stroke="none" class="t">×{ZOOM}</text>
        </g>
      </g>
    )}
  </svg>
</figure>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Magnifier for detail plates: a clipped, scaled copy of the drawing that follows the pointer.
  // (A deep clone rather than <use>: Chrome won't render SMIL-animated content through <use>.)
  document.querySelectorAll<HTMLElement>("figure.plate-detail").forEach((fig) => {
    const svg = fig.querySelector("svg") as SVGSVGElement;
    const lens = fig.querySelector<SVGCircleElement>(".lens-clip");
    const view = fig.querySelector<SVGGElement>(".loupe-view");
    const ring = fig.querySelector<SVGGElement>(".loupe-ring");
    const art = svg?.querySelector<SVGGElement>(`#plate-${fig.dataset.plate}-art`);
    const z = Number(fig.dataset.zoom) || 2.5;
    if (!svg || !lens || !view || !ring || !art) return;
    const copy = art.cloneNode(true) as SVGGElement;
    copy.removeAttribute("id");
    copy.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id")); // url(#…) refs still resolve to the originals
    view.appendChild(copy);
    const move = (e: PointerEvent) => {
      const m = svg.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      lens.setAttribute("cx", String(p.x));
      lens.setAttribute("cy", String(p.y));
      view.setAttribute("transform", `translate(${p.x} ${p.y}) scale(${z}) translate(${-p.x} ${-p.y})`);
      ring.setAttribute("transform", `translate(${p.x} ${p.y})`);
      fig.classList.add("is-zooming");
    };
    svg.addEventListener("pointermove", move);
    svg.addEventListener("pointerdown", move);
    svg.addEventListener("pointerleave", () => fig.classList.remove("is-zooming"));
  });

  document.querySelectorAll<HTMLElement>("figure.plate").forEach((fig) => {
    const svg = fig.querySelector("svg") as SVGSVGElement | null;
    if (!svg) return;
    // SMIL ignores prefers-reduced-motion, so pause it ourselves; also pause off-screen.
    if (reduce) {
      svg.setCurrentTime(4.2); // a "grown" frame, so nothing is left half-drawn
      svg.pauseAnimations();
    }
    let visible = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (reduce) return;
      visible ? svg.unpauseAnimations() : svg.pauseAnimations();
    }).observe(fig);

    // (the Research-page array only moves when you touch it, so it stays interactive with reduced motion)
    if (fig.dataset.plate === "tactile" && (!reduce || fig.classList.contains("plate-touch"))) {
      const cells = [...svg.querySelectorAll<SVGPathElement>(".taxels path")].map((el) => ({
        el,
        x: +el.dataset.x!,
        y: +el.dataset.y!,
        row: +el.dataset.row!,
        col: +el.dataset.col!,
        line: null as SVGLineElement | null,
      }));
      // The magnifier holds a copy of the drawing, so update every copy of the bars / contact marker.
      const barSets = [...svg.querySelectorAll<SVGGElement>(".bars")].map((g) => [...g.querySelectorAll<SVGRectElement>("rect")]);
      const contacts = [...svg.querySelectorAll<SVGGElement>(".contact")];
      const s2 = 2 * 30 * 30;
      const state = { amp: 0, peak: 0, active: 0, shear: 0, angle: 0, touching: false };
      (fig as any).plateState = state;
      const ROWS = 8;
      const rowY = (j: number) => 72 + j * 1.5 * 13;
      const rowMark = svg.querySelector<SVGPathElement>(".row-mark");
      const rowLabel = svg.querySelector<SVGTextElement>(".row-label");
      const setRow = (j: number) => {
        rowMark?.setAttribute("d", `M24 ${rowY(j)}h-8`);
        if (rowLabel) rowLabel.textContent = `ROW ${String(j + 1).padStart(2, "0")}`;
      };
      // Pressure (and, on the Research page, shear) at every taxel for a contact at (cx, cy).
      const paint = (cx: number, cy: number, amp: number, sx: number, sy: number, row: number) => {
        let peak = 0;
        let on = 0;
        for (const c of cells) {
          const p = amp * Math.exp(-((c.x - cx) ** 2 + (c.y - cy) ** 2) / s2);
          if (p > peak) peak = p;
          if (p > 0.25) on++;
          c.el.setAttribute("fill-opacity", (p * 0.85).toFixed(3));
          c.el.setAttribute("stroke-opacity", (0.22 + p * 0.6).toFixed(3));
          if (c.line) {
            c.line.setAttribute("x2", (c.x + sx * p * 14).toFixed(2));
            c.line.setAttribute("y2", (c.y + sy * p * 14).toFixed(2));
            c.line.setAttribute("stroke-opacity", Math.min(1, p * Math.hypot(sx, sy) * 2.2).toFixed(2));
          }
          if (c.row === row) {
            const h = p * 140;
            for (const bars of barSets) {
              bars[c.col]?.setAttribute("y", (160 - h).toFixed(1));
              bars[c.col]?.setAttribute("height", h.toFixed(1));
            }
          }
        }
        state.peak = peak;
        state.active = Math.round(on / Math.max(1, barSets.length)); // a magnifier would hold a second copy
      };

      if (!fig.classList.contains("plate-touch")) {
        // Homepage: the contact wanders across the array on its own.
        const t0 = performance.now();
        const tick = (now: number) => {
          if (visible) {
            const t = (now - t0) / 1000;
            const cx = 132 + 52 * Math.sin(t * 0.55);
            const cy = 146 + 36 * Math.sin(t * 0.83 + 0.6);
            for (const c of contacts) c.setAttribute("transform", `translate(${cx.toFixed(1)} ${cy.toFixed(1)})`);
            paint(cx, cy, 1, 0, 0, 3);
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        return;
      }

      // Research page: the cursor is the finger. Hover = light touch, press = firm press.
      // Shear comes from the finger's recent motion: the skin is dragged along with it,
      // and the pressure peak trails slightly behind.
      const lines = [...svg.querySelectorAll<SVGLineElement>(".shear line")];
      cells.forEach((c, i) => (c.line = lines[i]));
      const trail = svg.querySelector<SVGPolylineElement>(".trail");
      const hint = svg.querySelector<SVGTextElement>(".touch-hint");
      const arrow = svg.querySelector<SVGPathElement>(".shear-arrow");
      const PAD = { x0: 26, x1: 244, y0: 52, y1: 244 };
      let tx = 135,
        ty = 148,
        inside = false,
        down = false;
      const toSvg = (e: PointerEvent) => {
        const m = svg.getScreenCTM();
        return m ? new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse()) : null;
      };
      const onMove = (e: PointerEvent) => {
        const p = toSvg(e);
        if (!p) return;
        inside = p.x > PAD.x0 && p.x < PAD.x1 && p.y > PAD.y0 && p.y < PAD.y1;
        if (inside) {
          tx = p.x;
          ty = p.y;
        }
        if (inside) wake();
      };
      svg.addEventListener("pointermove", onMove);
      svg.addEventListener("pointerdown", (e) => {
        down = true;
        onMove(e);
      });
      window.addEventListener("pointerup", () => (down = false));
      svg.addEventListener("pointerleave", () => {
        inside = false;
        down = false;
      });

      let cx = tx,
        cy = ty,
        px = tx,
        py = ty,
        vx = 0,
        vy = 0,
        amp = 0,
        last = performance.now(),
        running = false;
      const hist: { x: number; y: number; t: number }[] = [];
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000) || 0.016;
        last = now;
        // follow the pointer, estimate its velocity (smoothed)
        cx += (tx - cx) * Math.min(1, dt / 0.04);
        cy += (ty - cy) * Math.min(1, dt / 0.04);
        const k = Math.min(1, dt / 0.12);
        vx += ((cx - px) / dt - vx) * k;
        vy += ((cy - py) / dt - vy) * k;
        px = cx;
        py = cy;
        amp += ((inside ? (down ? 1 : 0.62) : 0) - amp) * Math.min(1, dt / 0.08);
        let sx = vx * 0.006,
          sy = vy * 0.006;
        const sm = Math.hypot(sx, sy);
        if (sm > 1) {
          sx /= sm;
          sy /= sm;
        }
        const shear = Math.min(1, sm);
        // the pressure peak lags behind the moving finger
        const ox = cx - sx * 6,
          oy = cy - sy * 6;
        const row = Math.max(0, Math.min(ROWS - 1, Math.round((oy - 72) / (1.5 * 13))));
        setRow(row);
        paint(ox, oy, amp, sx * amp, sy * amp, row);
        for (const c of contacts) {
          c.setAttribute("transform", `translate(${cx.toFixed(1)} ${cy.toFixed(1)})`);
          c.setAttribute("opacity", Math.min(1, amp * 1.6).toFixed(2));
        }
        // same scale as the taxel arrows underneath (14 units × local pressure, which peaks at ≈ amp)
        const L = 14 * amp * amp;
        arrow?.setAttribute("d", shear * amp > 0.04 ? `M0 0L${(sx * L).toFixed(1)} ${(sy * L).toFixed(1)}` : "M0 0");
        // recent path of the finger
        const t = now / 1000;
        if (amp > 0.05) hist.push({ x: cx, y: cy, t });
        while (hist.length && t - hist[0].t > 0.9) hist.shift();
        trail?.setAttribute("points", hist.map((h) => `${h.x.toFixed(1)},${h.y.toFixed(1)}`).join(" "));
        hint?.setAttribute("opacity", (1 - Math.min(1, amp * 3)).toFixed(2));
        state.amp = amp;
        state.shear = shear * amp;
        state.angle = Math.atan2(sy, sx);
        state.touching = amp > 0.15;
        // stop when the finger has lifted and everything has settled
        if (!inside && amp < 0.002 && hist.length === 0) {
          running = false;
          paint(0, 0, 0, 0, 0, row);
          state.shear = 0;
          return;
        }
        requestAnimationFrame(tick);
      };
      const wake = () => {
        if (running) return;
        running = true;
        last = performance.now();
        requestAnimationFrame(tick);
      };
    }
  });
</script>

<style>
  .plate {
    margin: 0;
    background: #0f0f0f;
    aspect-ratio: 400 / 280;
    overflow: hidden;
  }
  .plate svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .plate :global(.t) {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    fill: #8c8c8c;
  }
  .plate-detail svg {
    cursor: crosshair;
    touch-action: pan-y;
  }
  .plate-touch svg {
    cursor: none;
    touch-action: none;
  }
  .plate .loupe {
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .plate.is-zooming .loupe {
    opacity: 1;
  }
  .plate :global(.ripple path) {
    transform-box: fill-box;
    transform-origin: center;
    animation: plate-ripple 2.4s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
    stroke-opacity: 0;
  }
  .plate :global(.ripple path:nth-child(2)) {
    animation-delay: 0.8s;
  }
  .plate :global(.ripple path:nth-child(3)) {
    animation-delay: 1.6s;
  }
  @keyframes plate-ripple {
    0% {
      transform: scale(0.8);
      stroke-opacity: 0.9;
    }
    100% {
      transform: scale(3.6);
      stroke-opacity: 0;
    }
  }
  .plate :global(.flow) {
    animation: plate-flow 0.9s linear infinite;
  }
  @keyframes plate-flow {
    to {
      stroke-dashoffset: -20;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate :global(.flow) {
      animation: none;
    }
  }
</style>
