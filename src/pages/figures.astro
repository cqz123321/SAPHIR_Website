---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { FIGURES } from "../data/figures";
import { AREA_LABELS } from "../lib/content";
import { withBase } from "../lib/urls";

// Figures come from src/data/figures.ts; images live in src/assets/figures/
// (downloaded by scripts/fetch-figures.mjs). A figure whose image is missing is skipped.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/figures/*.{png,jpg,jpeg,webp,gif,avif}", { eager: true });
const byName = new Map(Object.entries(files).map(([path, mod]) => [path.split("/").pop()!, mod.default]));

const AREA_ORDER = ["soft-robotics", "tactile-sensing", "autonomy", "medical", "assistive", "field"] as const;
const shown = FIGURES.filter((f) => byName.has(f.image));
const groups = await Promise.all(
  AREA_ORDER.map(async (area, gi) => ({
    area,
    index: gi + 1,
    label: AREA_LABELS[area],
    items: await Promise.all(
      shown
        .filter((f) => f.area === area)
        .map(async (f) => ({
          ...f,
          img: byName.get(f.image)!,
          full: (await getImage({ src: byName.get(f.image)!, width: 1600, format: "webp" })).src,
        })),
    ),
  })),
).then((gs) => gs.filter((g) => g.items.length > 0));
let n = 0;
---

<BaseLayout
  title="Figures"
  description="Selected figures from SAPHIR's open-access papers, grouped by research area, with credit and licence."
>
  <PageHeader
    index={4}
    motif="reticle"
    eyebrow="Selected figures"
    title="Figures"
    lead="Figures from the group's work, grouped by research area. Each one is credited to its paper. Click a figure to enlarge it."
    meta={`${shown.length} figures · ${groups.length} areas`}
  >
    <Fragment slot="readout">Cursor = measurement crosshair</Fragment>
  </PageHeader>

  <div class="container-page py-16 pb-24">
    {
      groups.length > 0 ? (
        <>
          <nav class="mb-14 flex flex-wrap gap-2" aria-label="Areas">
            {groups.map((g) => (
              <a href={`#${g.area}`} data-sfx="tick" class="label-mono border border-slate-300 px-3 py-2 text-slate-600 transition-colors hover:border-slate-900 hover:text-slate-900">
                {g.label} ({g.items.length})
              </a>
            ))}
          </nav>
          <div class="space-y-20">
            {groups.map((g) => (
              <section id={g.area} class="scroll-mt-24">
                <div class="mb-8 flex items-baseline gap-4 border-b border-slate-900 pb-3">
                  <span class="label-mono text-accent-600">F.{String(g.index).padStart(2, "0")}</span>
                  <h2 class="font-serif text-3xl tracking-tight">{g.label}</h2>
                  <a href={withBase(`/publications#${g.area}`)} class="label-mono ml-auto text-slate-500 transition-colors hover:text-accent-600" data-sfx="tick">
                    Papers &rarr;
                  </a>
                </div>
                <div class="grid gap-x-8 gap-y-12 md:grid-cols-2">
                  {g.items.map((f) => {
                    const i = n++;
                    const link = f.paper.doi ? `https://doi.org/${f.paper.doi}` : f.paper.url;
                    return (
                      <figure class="fig group">
                        <button
                          type="button"
                          class="fig-frame"
                          data-lb
                          data-index={i}
                          data-full={f.full}
                          data-caption={`${f.caption} — ${f.paper.authors} (${f.paper.year}), ${f.paper.venue}. ${f.license}.`}
                          aria-label={`Enlarge figure from “${f.paper.title}”`}
                          data-sfx="tick"
                        >
                          <Image src={f.img} alt={f.caption} widths={[480, 960]} sizes="(min-width: 768px) 34rem, 100vw" class="h-full w-full object-contain" />
                        </button>
                        <figcaption class="mt-4">
                          <p class="text-sm leading-relaxed text-slate-700">{f.caption}</p>
                          <p class="mt-3 border-t border-slate-200 pt-3 text-xs leading-relaxed text-slate-500">
                            {f.paper.authors} ({f.paper.year}). {link ? <a href={link} target="_blank" rel="noopener noreferrer" class="text-slate-800 underline decoration-accent-400 underline-offset-2 hover:text-accent-700">{f.paper.title}</a> : f.paper.title}. <em>{f.paper.venue}</em>.{" "}
                            {f.licenseUrl ? (
                              <>Reproduced under <a href={f.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-accent-700">{f.license}</a>.</>
                            ) : (
                              <>{f.license}.</>
                            )}
                          </p>
                        </figcaption>
                      </figure>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </>
      ) : (
        <p class="py-10 text-center text-slate-600">
          Figures are downloaded the first time the site is built (<code>npm run figures</code>).
        </p>
      )
    }
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 opacity-0 transition-opacity duration-200" aria-hidden="true">
    <button id="lb-close" type="button" aria-label="Close" class="absolute top-4 right-4 border border-white/20 p-2 text-white hover:border-accent-500">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>
    <button id="lb-prev" type="button" aria-label="Previous" class="absolute left-2 border border-white/20 p-2 text-white hover:border-accent-500 sm:left-4">
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
    </button>
    <figure class="flex max-h-full max-w-5xl flex-col items-center">
      <img id="lb-img" class="max-h-[80vh] w-auto bg-white" alt="" />
      <figcaption id="lb-cap" class="mt-3 max-w-3xl text-center text-sm text-neutral-300"></figcaption>
    </figure>
    <button id="lb-next" type="button" aria-label="Next" class="absolute right-2 border border-white/20 p-2 text-white hover:border-accent-500 sm:right-4">
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </button>
  </div>
</BaseLayout>

<style>
  .fig-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    cursor: zoom-in;
    transition: border-color 0.2s;
  }
  .fig-frame::before,
  .fig-frame::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid #df6335;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .fig-frame::before {
    top: -1px;
    left: -1px;
    border-top-width: 2px;
    border-left-width: 2px;
  }
  .fig-frame::after {
    right: -1px;
    bottom: -1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
  }
  .fig-frame:hover {
    border-color: #0b0b0b;
  }
  .fig-frame:hover::before,
  .fig-frame:hover::after {
    opacity: 1;
  }
</style>

<script>
  const lb = document.getElementById("lightbox")!;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbCap = document.getElementById("lb-cap")!;
  const items = [...document.querySelectorAll<HTMLElement>("[data-lb]")].map((b) => ({
    src: b.dataset.full!,
    cap: b.dataset.caption!,
  }));
  let cur = 0;
  const render = () => {
    lbImg.src = items[cur].src;
    lbImg.alt = items[cur].cap;
    lbCap.textContent = items[cur].cap;
  };
  const open = (i: number) => {
    cur = i;
    render();
    lb.classList.remove("hidden");
    lb.classList.add("flex");
    requestAnimationFrame(() => lb.classList.remove("opacity-0"));
    lb.setAttribute("aria-hidden", "false");
    document.documentElement.style.overflow = "hidden";
  };
  const close = () => {
    lb.classList.add("opacity-0");
    lb.setAttribute("aria-hidden", "true");
    document.documentElement.style.overflow = "";
    setTimeout(() => {
      lb.classList.add("hidden");
      lb.classList.remove("flex");
      lbImg.src = "";
    }, 200);
  };
  const step = (d: number) => {
    cur = (cur + d + items.length) % items.length;
    render();
  };
  document.querySelectorAll<HTMLElement>("[data-lb]").forEach((b) =>
    b.addEventListener("click", () => open(Number(b.dataset.index))),
  );
  document.getElementById("lb-close")!.addEventListener("click", close);
  document.getElementById("lb-prev")!.addEventListener("click", () => step(-1));
  document.getElementById("lb-next")!.addEventListener("click", () => step(1));
  lb.addEventListener("click", (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lb.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });
</script>
