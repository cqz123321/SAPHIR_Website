---
import { withBase } from "../lib/urls";
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Page not found">
  <PageHeader
    motif="noise"
    eyebrow="Error 404"
    title="No signal"
    lead="The page you're looking for doesn't exist, or it moved when we rebuilt the site."
    meta="Pattern: unknown"
  >
    <div slot="actions" class="mt-9 flex flex-wrap gap-3">
      <a href={withBase("/")} class="bg-white px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-accent-100" data-sfx="tick">Back to home</a>
      <a href={withBase("/people")} class="border border-white/30 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-white" data-sfx="tick">Meet the team</a>
    </div>
    <Fragment slot="readout">Signal lost · retry</Fragment>
  </PageHeader>
</BaseLayout>
