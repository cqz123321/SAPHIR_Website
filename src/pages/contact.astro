---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;
const socials = [
  { label: "Google Scholar", href: site.social.scholar },
  { label: "X / Twitter", href: site.social.twitter },
  { label: "GitHub", href: site.social.github },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} at ${site.institution}.`}
>
  <PageHeader
    index={6}
    motif="radar"
    eyebrow="Get in touch"
    title="Contact"
    meta="51.5241° N · 0.0404° W"
    lead="We welcome inquiries from prospective trainees, collaborators, and research participants' families."
  >
    <Fragment slot="readout">Mile End Campus · London E1 4NS</Fragment>
  </PageHeader>
  <div class="container-page py-16 pb-24">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-stretch">
      <div class="border-t-2 border-slate-900 pt-6">
        <p class="label-mono text-accent-600">Address</p>
        <h2 class="mt-3 font-serif text-3xl tracking-tight text-slate-900">{site.shortName}</h2>
        <address class="mt-4 text-lg leading-relaxed text-slate-600 not-italic">
          {site.address.map((line) => <p>{line}</p>)}
        </address>

        <dl class="mt-6 space-y-2 text-sm">
          {site.email && <div class="flex gap-2">
            <dt class="font-medium text-slate-600">Email</dt>
            <dd>
              <a
                href={`mailto:${site.email}`}
                class="link-rule">{site.email}</a
              >
            </dd>
          </div>}
          {site.phone && <div class="flex gap-2">
            <dt class="font-medium text-slate-600">Phone</dt>
            <dd>
              <a
                href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`}
                class="link-rule">{site.phone}</a
              >
            </dd>
          </div>}
        </dl>

        <h3 class="label-mono mt-10 text-accent-600">
          Elsewhere
        </h3>
        <ul class="mt-2 space-y-1 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-rule"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <div class="map-frame relative grow overflow-hidden border-2 border-slate-900">
          <iframe
            title={`Map to ${site.shortName}`}
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-80 w-full grayscale-[60%] contrast-[1.05] transition duration-500 hover:grayscale-0 lg:h-full lg:min-h-96"></iframe>
        </div>
        <a
          href={mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group link-rule inline-flex items-center gap-1 self-start text-sm"
        >
          Open in Google Maps
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
