---
import { withBase } from "../lib/urls";
import { site } from "../data/site";
import { getGroupedPeople } from "../lib/content";
import BaseLayout from "../components/BaseLayout.astro";
import TaxelField from "../components/TaxelField.astro";
import ResearchPlate from "../components/ResearchPlate.astro";
import PeopleSelect from "../components/PeopleSelect.astro";

const official = "https://www.sems.qmul.ac.uk/research/groups/softrobotics/";

const team = (await getGroupedPeople())
  .flatMap((g) => g.people)
  .filter((p) => p.data.status === "current");

const themes = [
  {
    title: "Soft robotics",
    body: "Compliant structures for adaptable movement and manipulation.",
    plate: "soft",
    tag: "SOFT / EVERSION",
  },
  {
    title: "Sensing & interaction",
    body: "Tactile feedback to understand contact with the environment.",
    plate: "tactile",
    tag: "TACTILE / TAXEL ARRAY",
  },
  {
    title: "Robot autonomy",
    body: "Intelligent sensing and modelling for navigation and control.",
    plate: "arm",
    tag: "AUTONOMY / REACH",
  },
] as const;

const applications = [
  { title: "Minimally invasive surgery", body: "Soft, sensorised instruments that can move safely inside the body." },
  { title: "Rehabilitation", body: "Compliant devices that support recovery through gentle physical contact." },
  { title: "Assistive technologies", body: "Robots that help people with everyday tasks at home and in care." },
  { title: "Human–robot collaboration", body: "Robots that feel contact and work safely alongside people in industry." },
];

const spec = [
  ["Centre", "ARQ · QMUL"],
  ["School", "SEMS"],
  ["Lead", "Prof. K. Althoefer"],
  ["Members", String(team.length)],
  ["Based in", "Mile End, London"],
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero relative overflow-hidden bg-[#0b0b0b] text-white">
    <TaxelField />

    <div class="hero-frame container-page relative flex flex-col justify-between">
      <div class="hero-meta flex items-center justify-between border-b border-white/15 pb-3 text-neutral-400">
        <span class="label-mono">Queen Mary University of London</span>
        <span class="label-mono hidden sm:inline">Centre for Advanced Robotics · ARQ</span>
      </div>

      <div class="py-14 sm:py-16">
        <h1 class="eva-title">
          <span class="t1">SAPHIR</span>
          <span class="t2-row">
            <span class="t2">ROBOTICS</span>
            <span class="t2-rule" aria-hidden="true"></span>
          </span>
        </h1>

        <p class="hero-sub label-mono mt-7 text-neutral-300">
          Soft Articulated Physical-Interaction Intelligent Robots
        </p>

        <p class="hero-lead mt-5 max-w-md text-base leading-relaxed text-neutral-400 sm:text-lg">
          {site.description}
        </p>

        <div class="hero-actions mt-9 flex flex-wrap gap-3">
          <a href="#research" data-sfx="tick" class="bg-white px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-accent-100">
            Explore our research
          </a>
          <a href={withBase("/people")} data-sfx="tick" class="border border-white/30 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/5">
            Meet the team
          </a>
        </div>
      </div>

      <div class="hero-meta flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-white/15 pt-3 text-neutral-500">
        <span class="label-mono">51.5241° N · 0.0404° W</span>
        <span class="label-mono">
          Taxel array <span data-taxel-count>—</span>
          <span class="mx-2 text-neutral-700">/</span>
          Contact <span class="text-accent-400" data-taxel-force>0.00</span> N
          <span class="hidden sm:inline">
            <span class="mx-2 text-neutral-700">/</span>
            Active <span class="text-neutral-300" data-taxel-active>000</span>
          </span>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ 01 ABOUT ============ -->
  <section class="container-page grid gap-10 py-20 md:grid-cols-[1fr_2fr] md:gap-12">
    <div>
      <p class="label-mono text-accent-600">01 — About</p>
      <h2 class="mt-3 font-serif text-4xl tracking-tight">About SAPHIR</h2>
      <dl class="mt-8 max-w-xs border-b border-slate-200">
        {spec.map(([k, v]) => (
          <div class="flex items-baseline justify-between gap-4 border-t border-slate-200 py-2">
            <dt class="label-mono text-slate-500">{k}</dt>
            <dd class="text-sm text-slate-900">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="space-y-5 text-lg leading-relaxed text-slate-600 md:pt-9">
      <p>Based in the <a class="underline underline-offset-4 hover:text-black" href="https://www.sems.qmul.ac.uk/">School of Engineering and Materials Science</a> at <a class="underline underline-offset-4 hover:text-black" href="https://www.seresearch.qmul.ac.uk/robotics/">The Centre for Advanced Robotics @ Queen Mary (ARQ)</a>, SAPHIR is led by Professor <a class="underline underline-offset-4 hover:text-black" href="https://www.sems.qmul.ac.uk/staff/k.althoefer">Kaspar Althoefer</a>.</p>
      <p>The group conducts interdisciplinary research in robot autonomy, soft robotics, tactile sensing and tool–environment interaction, aiming to develop robotic systems that are intelligent, compliant, and capable of safe and effective physical interaction in real-world tasks.</p>
      <p>SAPHIR focuses on enabling robots to perform complex manipulation and navigation tasks through the integration of soft materials, intelligent sensing, and dynamic modelling.</p>
      <a href={official} class="inline-block text-sm font-medium text-slate-900 underline decoration-accent-500 decoration-2 underline-offset-4 hover:text-accent-700">Our group at QMUL ↗</a>
    </div>
  </section>

  <!-- ============ 02 RESEARCH ============ -->
  <section id="research" class="scroll-mt-16 border-y border-slate-200 bg-neutral-50">
    <div class="container-page py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="label-mono text-accent-600">02 — Research</p>
          <h2 class="mt-3 font-serif text-4xl tracking-tight">Research directions</h2>
        </div>
        <a href={withBase("/research")} class="text-sm font-medium text-slate-900 underline decoration-accent-500 decoration-2 underline-offset-4 hover:text-accent-700">All research →</a>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {themes.map((theme, i) => (
          <article>
            <ResearchPlate kind={theme.plate} index={i + 1} tag={theme.tag} />
            <div class="mt-5 flex items-baseline gap-3 border-t border-slate-300 pt-4">
              <span class="label-mono text-accent-600">0{i + 1}</span>
              <h3 class="font-serif text-2xl tracking-tight text-slate-900">{theme.title}</h3>
            </div>
            <p class="mt-2 text-slate-600">{theme.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 03 APPLICATIONS ============ -->
  <section class="container-page py-20">
    <div class="grid gap-6 md:grid-cols-[1fr_2fr] md:gap-12">
      <div>
        <p class="label-mono text-accent-600">03 — Application</p>
        <h2 class="mt-3 font-serif text-4xl tracking-tight">From interaction<br />to application</h2>
      </div>
      <div class="md:pt-9">
        <p class="text-lg leading-relaxed text-slate-600">Our research supports minimally invasive surgery, rehabilitation, assistive technologies and collaboration between people and robots in industry.</p>
        <a href={official + "research/"} class="mt-5 inline-block text-sm font-medium text-slate-900 underline decoration-accent-500 decoration-2 underline-offset-4 hover:text-accent-700">Explore research at QMUL ↗</a>
      </div>
    </div>

    <ol class="mt-12 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
      {applications.map((a, i) => (
        <li class="border-t border-slate-900 pt-4 pb-8">
          <span class="label-mono text-slate-500">A.{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-3 font-serif text-xl tracking-tight text-slate-900">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{a.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ 04 PEOPLE ============ -->
  <section class="bg-[#0b0b0b] text-white">
    <div class="container-page py-20">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <p class="label-mono text-accent-400">04 — People</p>
          <h2 class="mt-3 font-serif text-4xl tracking-tight text-white">Meet the people behind SAPHIR</h2>
          <p class="mt-3 text-neutral-400">{team.length} team members · Faculty, postdoctoral researchers and PhD students.</p>
        </div>
        <a href={withBase("/people")} data-sfx="tick" class="shrink-0 bg-white px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-accent-100">Our people →</a>
      </div>

      <div class="mt-10">
        <PeopleSelect people={team} variant="strip" />
      </div>
      <p class="label-mono mt-4 text-neutral-600">Select a member ↑</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero frame ---------- */
  .hero-frame {
    min-height: clamp(560px, calc(100svh - 4rem), 880px);
    padding-top: 1.75rem;
    padding-bottom: 1.5rem;
    /* Pointer movement over the text should still reach the taxel field (it
       listens on the section); only links take pointer events. */
    pointer-events: none;
  }
  .hero-frame a {
    pointer-events: auto;
  }

  /* ---------- title: big / small, flush left, closed by a right-angle rule ---------- */
  .eva-title {
    display: inline-block;
    font-family: var(--font-matisse);
    font-weight: 900;
    font-size: clamp(4.5rem, 21vw, 15rem);
    line-height: 1;
    color: #fff;
    white-space: nowrap;
  }
  .eva-title .t1 {
    display: block;
    line-height: 0.84;
    letter-spacing: -0.045em;
    margin-left: -0.04em; /* optical: pull the S onto the text edge */
  }
  .eva-title .t2-row {
    display: flex;
    align-items: center;
    gap: 0.12em;
    margin-top: 0.1em;
    font-size: 0.405em;
  }
  .eva-title .t2 {
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .eva-title .t2-rule {
    position: relative;
    flex: 1;
    min-width: 0.6em;
    height: 2px;
    margin-left: 0.18em;
    background: #df6335;
    transform: scaleX(0);
    transform-origin: left;
    animation: hero-line-in 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.8s forwards;
  }
  .eva-title .t2-rule::after {
    /* the turn: the rule drops at a right angle */
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 0.62em;
    background: #df6335;
    transform: scaleY(0);
    transform-origin: top;
    animation: hero-drop-in 0.35s ease-out 1.45s forwards;
  }

  /* ---------- entrance animations ---------- */
  .t1,
  .t2 {
    opacity: 0;
    animation: hero-title-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .t1 {
    animation-delay: 0.15s;
  }
  .t2 {
    animation-delay: 0.35s;
  }
  .hero-meta {
    opacity: 0;
    animation: hero-fade-in 0.8s ease 0.05s forwards;
  }
  .hero-sub {
    opacity: 0;
    animation: hero-fade-in 0.8s ease 1.05s forwards;
    letter-spacing: 0.2em;
  }
  .hero-lead {
    opacity: 0;
    animation: hero-fade-in 0.8s ease 1.2s forwards;
  }
  .hero-actions {
    opacity: 0;
    animation: hero-fade-in 0.7s ease 1.35s forwards;
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-line-in {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes hero-drop-in {
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t1,
    .t2,
    .hero-meta,
    .hero-sub,
    .hero-lead,
    .hero-actions,
    .eva-title .t2-rule,
    .eva-title .t2-rule::after {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
