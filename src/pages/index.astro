---
import { withBase } from "../lib/urls";
import BaseLayout from "../components/BaseLayout.astro";
import matisseFont from "../assets/fonts/matisse-title.woff2?url";
import { getCollection } from "astro:content";
const people = await getCollection("people");
const official = "https://www.sems.qmul.ac.uk/research/groups/softrobotics/";
const themes = [
  { title: "Soft robotics", body: "Compliant structures for adaptable movement and manipulation." },
  { title: "Sensing & interaction", body: "Tactile feedback to understand contact with the environment." },
  { title: "Robot autonomy", body: "Intelligent sensing and modelling for navigation and control." },
];
---
<BaseLayout>
  <style is:inline set:html={`@font-face { font-family: "SAPHIR Matisse"; src: url("${matisseFont}") format("woff2"); font-weight: 900; font-style: normal; font-display: swap; }`} />
  <section class="bg-white">
    <div class="container-page py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        
          <p class="hero-eyebrow text-sm font-semibold tracking-wide text-black uppercase">
            Queen Mary University of London · ARQ
          </p>

          <h1 class="eva-title mt-6">
            <span class="hero-title-line hero-title-first">SAPHIR</span>
            <span class="hero-title-line hero-title-second">ROBOTICS</span>
          </h1>

          <div class="hero-accent" aria-hidden="true"></div>

          <p class="hero-subtitle mx-auto mt-7 max-w-xl text-base leading-relaxed tracking-wide text-black sm:text-lg">
            Soft Articulated Physical-Interaction<br />
            Intelligent Robots
          </p>

        <div class="hero-actions mt-8 flex flex-wrap justify-center gap-3">
          <a href="#research" class="rounded-none bg-black px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800">Explore our research</a>
          <a href={withBase("/people")} class="rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Meet the team</a>
        </div>
      </div>
    </div>
  </section>
  <section class="container-page grid gap-8 py-14 md:grid-cols-[1fr_2fr]">
    <h2 class="font-serif text-3xl text-slate-900">About SAPHIR</h2>
    <div class="space-y-4 text-lg text-slate-600">
      <p>Based in the <a class="underline underline-offset-4 hover:text-black" href="https://www.sems.qmul.ac.uk/">School of Engineering and Materials Science</a> at <a class="underline underline-offset-4 hover:text-black" href="https://www.seresearch.qmul.ac.uk/robotics/">The Centre for Advanced Robotics @ Queen Mary (ARQ)</a>, SAPHIR is led by Professor <a class="underline underline-offset-4 hover:text-black" href="https://www.sems.qmul.ac.uk/staff/k.althoefer">Kaspar Althoefer</a>.</p>
      <p>The group conducts interdisciplinary research in robot autonomy, soft robotics, tactile sensing and tool–environment interaction, aiming to develop robotic systems that are intelligent, compliant, and capable of safe and effective physical interaction in real-world tasks.</p>
      <p>SAPHIR focuses on enabling robots to perform complex manipulation and navigation tasks through the integration of soft materials, intelligent sensing, and dynamic modelling.</p>
      <a href={official} class="inline-block text-sm font-medium text-primary-700 hover:underline">Our group at QMUL ↗</a>
    </div>
  </section>
  <section id="research" class="scroll-mt-24 bg-slate-50">
    <div class="container-page py-16">
      <h2 class="mb-9 font-serif text-3xl text-slate-900">Research directions</h2>
      <div class="grid gap-10 md:grid-cols-3">
        {themes.map((theme, i) => <article><p class="text-sm font-semibold text-accent-600">0{i + 1}</p><h3 class="mt-3 font-serif text-2xl text-slate-900">{theme.title}</h3><p class="mt-3 text-slate-600">{theme.body}</p></article>)}
      </div>
    </div>
  </section>
  <section class="container-page grid gap-8 py-16 md:grid-cols-[1fr_2fr]">
    <h2 class="font-serif text-3xl text-slate-900">From interaction<br />to application</h2>
    <div><p class="text-lg text-slate-600">Our research supports minimally invasive surgery, rehabilitation, assistive technologies and collaboration between people and robots in industry.</p><a href={official + "research/"} class="mt-6 inline-block text-sm font-medium text-primary-700 hover:underline">Explore research at QMUL ↗</a></div>
  </section>
  <section class="bg-primary-50">
    <div class="container-page flex flex-col items-start justify-between gap-6 py-14 sm:flex-row sm:items-center">
      <div><h2 class="font-serif text-3xl text-slate-900">Meet the people behind SAPHIR</h2><p class="mt-3 text-slate-600">{people.filter(p => p.data.status === "current").length} team members · Faculty, postdoctoral researchers and PhD students.</p></div>
      <a href={withBase("/people")} class="shrink-0 rounded-none bg-black px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800">Our people →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eva-title {
    font-family: "SAPHIR Matisse", "Times New Roman", serif;
    font-size: clamp(3.5rem, 12vw, 8rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.055em;
    color: #000;
    text-wrap: nowrap;
  }
  
  /* SAPHIR hero entrance animations */
  .hero-actions {
    opacity: 0;
    animation: hero-fade-in 0.7s ease 1.2s forwards;
  }
  .hero-title-line {
    display: block;
    opacity: 0;
    animation: hero-title-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-title-first {
    animation-delay: 0.15s;
  }

  .hero-title-second {
    animation-delay: 0.32s;
  }

  .hero-eyebrow {
    opacity: 0;
    animation: hero-fade-in 0.7s ease 0.05s forwards;
  }

  .hero-subtitle {
    opacity: 0;
    animation: hero-fade-in 0.8s ease 0.95s forwards;
  }

  /* Subtle EVA-inspired orange accent */
  .hero-accent {
    width: min(260px, 55%);
    height: 2px;
    margin: 1.5rem auto -0.25rem;
    background: #df6335;
    transform: scaleX(0);
    transform-origin: left;
    animation: hero-line-in 0.6s ease-out 0.75s forwards;
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-line-in {
    to {
      transform: scaleX(1);
    }
  }


  /* Accessibility: disable animations when requested */
  @media (prefers-reduced-motion: reduce) {
    .hero-title-line,
    .hero-eyebrow,
    .hero-subtitle,
    .hero-accent,
    .hero-actions {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }


</style>
