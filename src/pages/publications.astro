---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import { getPublications, getAreaCounts, AREA_LABELS, FILTER_GROUPS } from "../lib/content";

const pubs = await getPublications();
const areaCounts = await getAreaCounts();
const areaChips = FILTER_GROUPS.flatMap((g) => g.slugs);

const chip =
  "label-mono border border-slate-300 px-3 py-2 text-slate-600 transition-colors hover:border-slate-900 hover:text-slate-900 data-[active]:border-slate-900 data-[active]:bg-slate-900 data-[active]:text-white";
const years = pubs.map((p) => p.data.year);
const since = years.length ? Math.min(...years) : undefined;

---

<BaseLayout
  title="Publications"
  description="Publications from the SAPHIR group, filterable by research area."
>
  <PageHeader
    index={3}
    motif="stream"
    eyebrow="Research output"
    title="Publications"
    meta={`${pubs.length} papers${since ? ` · since ${since}` : ""}`}
    lead="Work by members of the group, newest first. Filter by research area or search by title and author."
  >
    <Fragment slot="readout">Newest first</Fragment>
  </PageHeader>
  <div class="container-page py-14 pb-24">
    <div class="mb-8 space-y-3">
      <button
        type="button"
        id="filters-toggle"
        class="label-mono inline-flex items-center gap-2 border border-slate-300 px-3 py-2 text-slate-700 hover:border-slate-900 md:hidden"
        aria-controls="pub-filters"
        aria-expanded="false"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
      </button>

      <div id="pub-filters" class="hidden space-y-3 md:block">

        <div class="flex flex-wrap items-center gap-2">
          <span class="label-mono mr-1 text-accent-600">Area</span>
        <button data-sfx="tick" class={chip} data-area="all" data-active>All areas</button>
        {
          areaChips.map((slug) => (
            <button data-sfx="tick" class={chip} data-area={slug}>
              {AREA_LABELS[slug]}{" "}
              <span class="opacity-70">({areaCounts[slug] ?? 0})</span>
            </button>
          ))
        }
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <input
          type="search"
          id="pub-search"
          placeholder="Search title or author…"
          class="min-w-56 flex-1 border-0 border-b-2 border-slate-900 bg-transparent px-1 py-2 text-base placeholder:text-slate-400 focus:border-accent-500 focus:outline-none"
        />
        <span id="pub-count" class="label-mono text-slate-500"></span>
      </div>
    </div>

    <PubList pubs={pubs} />

    <p id="pub-empty" class="hidden py-10 text-center text-slate-600">
      No publications match your filters.
    </p>
  </div>

  <script>
    const list = document.getElementById("pub-list");
    const items = list ? [...list.querySelectorAll<HTMLElement>("[data-pub]")] : [];
    const search = document.getElementById("pub-search") as HTMLInputElement | null;
    const countEl = document.getElementById("pub-count");
    const emptyEl = document.getElementById("pub-empty");
    // Mobile: toggle the (collapsed) filter panel.
    const filtersToggle = document.getElementById("filters-toggle");
    const filtersPanel = document.getElementById("pub-filters");
    filtersToggle?.addEventListener("click", () => {
      const open = filtersToggle.getAttribute("aria-expanded") === "true";
      filtersToggle.setAttribute("aria-expanded", String(!open));
      filtersPanel?.classList.toggle("hidden");
    });

    const areaBtns = [...document.querySelectorAll<HTMLElement>("[data-area]")];
    let area = "all";

    function apply() {
      const q = (search?.value ?? "").trim().toLowerCase();
      let n = 0;
      for (const li of items) {
        const okArea = area === "all" || (li.dataset.areas ?? "").split(" ").includes(area);
        const okSearch = !q || (li.dataset.search ?? "").includes(q);
        li.hidden = !(okArea && okSearch);
        if (!li.hidden) n++;
      }
      if (countEl) countEl.textContent = `${n} of ${items.length}`;
      if (emptyEl) emptyEl.classList.toggle("hidden", n !== 0);
    }

    const setActive = (active: HTMLElement) =>
      areaBtns.forEach((x) => (x === active ? x.setAttribute("data-active", "") : x.removeAttribute("data-active")));

    for (const b of areaBtns)
      b.addEventListener("click", () => {
        area = b.dataset.area ?? "all";
        setActive(b);
        apply();
      });
    search?.addEventListener("input", apply);

    // Deep link: /publications#<area-slug> pre-selects that area.
    const hash = decodeURIComponent(location.hash.replace(/^#/, ""));
    const fromHash = areaBtns.find((b) => b.dataset.area === hash);
    if (fromHash) {
      area = hash;
      setActive(fromHash);
      filtersPanel?.classList.remove("hidden");
      filtersToggle?.setAttribute("aria-expanded", "true");
    }
    apply();
  </script>
</BaseLayout>
