---
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import PeopleSelect from "../../components/PeopleSelect.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
const groupLabels: Record<string, string> = { Faculty: "Principal Investigator", Researchers: "Postdoctoral Researchers", Students: "PhD Students" };
const current = groups.flatMap((g) => g.people).filter((p) => p.data.status === "current");
const readout = groups
  .filter((g) => g.group !== "Alumni")
  .map((g) => `${g.group} ${String(g.people.length).padStart(2, "0")}`)
  .join(" / ");
---

<BaseLayout
  title="People"
  description="Meet the SAPHIR soft robotics team at Queen Mary University of London."
>
  <PageHeader
    index={1}
    motif="scan"
    eyebrow="The team"
    title="People"
    lead="Our principal investigator, postdoctoral researchers, and PhD students."
    meta={`${current.length} members · Mile End, London`}
  >
    <Fragment slot="readout">{readout}</Fragment>
  </PageHeader>

  <section class="border-t border-white/10 bg-[#0b0b0b] text-white">
    <div class="container-page py-14">
      <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
        <p class="label-mono text-accent-400">Select a member</p>
        <p class="label-mono hidden text-neutral-600 sm:block">Hover to preview · click to open profile</p>
      </div>
      <PeopleSelect people={current} variant="screen" />
    </div>
  </section>

  <div class="container-page py-20">
    <div class="mb-12">
      <p class="label-mono text-accent-600">Roster</p>
      <h2 class="mt-3 font-serif text-4xl tracking-tight">Everyone, in full</h2>
    </div>
    {groups.map((g, i) => <PersonGroup title={groupLabels[g.group] ?? g.group} people={g.people} index={i + 1} />)}
  </div>
</BaseLayout>
