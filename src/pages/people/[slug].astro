---
import { render } from "astro:content";
import ProfileLayout from "../../components/ProfileLayout.astro";
import PubList from "../../components/PubList.astro";
import { getPublications, publicationsForPerson, getGroupedPeople } from "../../lib/content";

export async function getStaticPaths() {
  const ordered = (await getGroupedPeople()).flatMap((g) => g.people);
  return ordered.map((person, i) => ({
    params: { slug: person.id },
    props: { person, prev: ordered[i - 1], next: ordered[i + 1], no: i + 1 },
  }));
}

const { person, prev, next, no } = Astro.props;
const { Content } = await render(person);
const hasBio = (person.body ?? "").trim().length > 0;

const pubs = await getPublications();
const mine = publicationsForPerson(person, pubs).slice(0, 15);
---

<ProfileLayout person={person} prev={prev} next={next} no={no}>
  {
    hasBio && (
      <div class="prose-content space-y-4 text-lg leading-relaxed text-slate-700">
        <Content />
      </div>
    )
  }

  {
    mine.length > 0 && (
      <section class:list={[hasBio && "mt-10"]}>
        <p class="label-mono text-accent-600">Output</p>
        <h2 class="mt-2 mb-1 font-serif text-2xl tracking-tight text-slate-900">
          Selected publications
        </h2>
        <PubList pubs={mine} />
      </section>
    )
  }
</ProfileLayout>
